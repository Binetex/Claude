# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
# Каталоги деплоя: сборка в стороне, готовый откат и сохранённая неудачная сборка
# (см. deploy.sh). Без них `git status` на сервере всегда показывает мусор.
/.next.build/
/.next.previous/
/.next.failed/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — реальные секреты никогда не коммитим; *.example — документация, коммитим.
# Список имён не годится: на проде рядом с .env однажды остался .env.neon-backup-… с полной
# копией боевых секретов, и под старые правила он НЕ подпадал — один `git add -A` на сервере
# отправил бы их в репозиторий. Поэтому игнорируем всё семейство, а нужное разрешаем явно.
.env
.env.*
!.env.example
!.env.*.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# uploaded photos (этап 1 — локальное хранилище, см. src/lib/storage.ts)
/public/uploads/*
!/public/uploads/.gitkeep

# PM2 логи
/logs/*
!/logs/.gitkeep

# нормализация git: бэкап старого prod .git и устаревший маркер rsync-деплоя
/.git.legacy-*
.deploy-fast.deps.hash
