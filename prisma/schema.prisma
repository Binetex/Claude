// Florist Dashboard — единый дашборд управления заказами.
// Ключевые принципы (см. ТЗ):
//  - раздельные статусы: оплата / заказ / назначение / доставка / синхронизация;
//  - раздельные финансовые поля;
//  - цена флориста фиксируется в заказе снимком в момент назначения;
//  - открытка и заметка клиента хранятся с оригиналами и не меняются автоматически.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────  ENUMS  ─────────────────────────────

enum Role {
  OWNER
  FLORIST
  CALL_CENTER
}

enum Platform {
  WOOCOMMERCE
  SHOPIFY
}

enum ConnectionStatus {
  CONNECTED
  DISCONNECTED
  PENDING
}

// Режим аутентификации Shopify конкретного Site. Новый сценарий — CUSTOM_APP
// (Dev Dashboard app + client_credentials, отдельное приложение на каждый магазин).
enum ShopifyAuthMode {
  CUSTOM_APP
}

// Детальный статус подключения Shopify Custom App.
enum ShopifyConnStatus {
  CONNECTING // введены credentials, идёт первичная проверка
  CONNECTED // токен получен, домен и обязательные scopes подтверждены
  DEGRADED // подключён, но не хватает части обязательных scopes
  REAUTH_REQUIRED // credentials больше не действуют (повторный 401 / отзыв secret / удалён app)
  DISCONNECTED // отключён владельцем (история и товары сохранены)
}

// Статус подключения WooCommerce-магазина (отдельно от Shopify — свой жизненный цикл).
enum WooConnStatus {
  CONNECTING // введены credentials, идёт первичная проверка REST API
  CONNECTED // REST API доступен, права read/write подтверждены
  DEGRADED // подключён, но часть прав/эндпоинтов недоступна
  REAUTH_REQUIRED // 401/403 — credentials недействительны или отозваны
  DISCONNECTED // отключён владельцем (история и товары сохранены)
}

enum PaymentStatus {
  UNPAID
  PAID
  PAY_LATER_APPROVED // BNPL (Klarna/Airwallex) авторизован: заказ валиден, оплата поступит позже — НЕ считать неоплатой
  REFUNDED
  PARTIALLY_REFUNDED
}

// Статус самого заказа (жизненный цикл). "Новый" не используется — оплаченный сразу CONFIRMED.
enum OrderStatus {
  AWAITING_PAYMENT
  CONFIRMED
  ASSIGNED
  FLORIST_ACCEPTED
  IN_PROGRESS
  READY
  AWAITING_COURIER
  IN_TRANSIT
  DELIVERED
  PROBLEM
  CANCELLED
}

// Текущее состояние назначения на уровне заказа (отдельно от истории назначений).
enum AssignmentStatus {
  UNASSIGNED // требует назначения (никого нет / все отказались)
  ASSIGNED // назначен, ждём реакции флориста
  ACCEPTED // флорист принял
}

// Состояние конкретной записи назначения (история).
enum AssignmentState {
  ASSIGNED
  ACCEPTED
  DECLINED
  REASSIGNED
}

enum DeliveryStatus {
  PENDING
  SCHEDULED
  IN_TRANSIT
  DELIVERED
  FAILED
}

// ── BURQ доставка ──
enum DeliveryProvider {
  BURQ
}

// Нормализованный статус попытки доставки (не привязан к строкам Burq).
enum DeliveryProviderStatus {
  DRAFT_PENDING // задача поставлена, черновик ещё не создан
  DRAFT_CREATED // Burq order создан (request), ждёт ручного checkout/dispatch флористом
  SCHEDULED
  COURIER_ASSIGNED
  COURIER_EN_ROUTE_TO_PICKUP
  AT_PICKUP
  PICKED_UP
  IN_TRANSIT
  DELIVERED
  PROBLEM // attempting reroute / disputed — зависшее проблемное состояние (terminal-like для автоматики)
  CANCEL_REQUESTED
  CANCELLED
  FAILED
  RETURNING
  RETURNED
  UNKNOWN
}

// Статус планирования черновика (DeliveryIntent).
enum DeliveryIntentStatus {
  SCHEDULED // задача запланирована (PENDING в outbox)
  WAITING_FOR_FLORIST // доставка сегодня, но флорист не назначен / pickup не готов
  DRAFT_CREATED // черновик успешно создан
  SKIPPED // задача пропущена (не eligible), без ошибки
  FAILED // создание завершилось ошибкой
}

// Источник изменения статуса доставки (для истории/аудита).
enum DeliveryEventSource {
  BURQ_WEBHOOK
  MANUAL_ADMIN
  POLLING
  SYSTEM
}

enum SyncStatus {
  LOCAL // создан внутри системы / тестовый
  SYNCED
  PENDING
  ERROR
}

enum PriceMode {
  AUTO
  MANUAL
}

// Что флорист видит по финансам заказа. Не влияет на видимость чужих цен
// или прибыли владельца — те скрыты от флориста в любом режиме (см. CLAUDE.md).
enum FloristFinanceVisibility {
  MAKER_ONLY // видит только назначенную ему цену изготовления (по умолчанию)
  FULL // дополнительно видит налог, доставку клиента, чаевые и итог клиента
}

enum MessageChannel {
  SMS
  EMAIL
}

enum MessageDirection {
  OUTBOUND
  INBOUND
}

enum MessageParty {
  SENDER
  RECIPIENT
}

// ── QUO (ex-OpenPhone) единая история коммуникаций по заказу ──
enum CommunicationType {
  SMS
  CALL
  VOICEMAIL
}

enum CommunicationDirection {
  INBOUND
  OUTBOUND
}

enum CommunicationPartyRole {
  CUSTOMER // телефон покупателя (Order.senderPhone / billing)
  RECIPIENT // телефон получателя доставки (Order.recipientPhone)
  UNKNOWN // не удалось сопоставить роль
}

enum CommunicationStatus {
  PENDING // исходящее создано, ещё не подтверждено провайдером
  SENT
  DELIVERED
  RECEIVED // входящее сообщение
  COMPLETED // завершённый звонок
  MISSED // пропущенный/без ответа звонок
  FAILED
}

enum BackfillMode {
  DRY_RUN
  LIVE
}

enum BackfillStatus {
  RUNNING
  DONE
  FAILED
}

/**
 * История запусков backfill QUO: период, фильтры, режим, статус, счётчики/разбивка, инициатор,
 * время, безопасная ошибка. `activeLock` (@unique) держит один активный LIVE-запуск (защита от гонки/
 * двойного запуска): "ACTIVE" пока идёт LIVE, null после завершения.
 */
model QuoBackfillRun {
  id                String         @id @default(cuid())
  mode              BackfillMode
  status            BackfillStatus @default(RUNNING)
  fromAt            DateTime
  toAt              DateTime
  siteId            String?
  quoPhoneNumberId  String?
  counters          Json? // {found,created,updated,skipped,unlinked,errors}
  breakdown         Json? // {byType:{...}, bySite:{...}}
  initiatedByUserId String?
  startedAt         DateTime       @default(now())
  finishedAt        DateTime?
  safeError         String?
  activeLock        String?        @unique // "ACTIVE" пока идёт LIVE-запуск; null иначе

  @@index([startedAt])
}

// Статус товара — источник истины Shopify (active/draft/archived).
enum ProductStatus {
  ACTIVE
  DRAFT
  ARCHIVED
}

// Тип фоновой синхронизации сайта (универсально для Shopify/WooCommerce).
enum SyncKind {
  PRODUCTS
  ORDERS
}

// Аудитория внутреннего Telegram-уведомления. Один заказ может иметь ОТДЕЛЬНОЕ основное
// сообщение у флористов и у владельца — они не затирают друг друга.
// Назначение бота. Разные боты могут указывать на ОДИН чат — chatId живёт на боте,
// а не на аудитории, поэтому это не создаёт конфликта.
enum AirwallexNormalizedStatus {
  PAID
  AUTHORIZED_NOT_CAPTURED
  PENDING
  ACTION_REQUIRED
  FAILED
  NOT_STARTED
  CANCELLED
  NOT_FOUND
  UNKNOWN
}

/// Шаг воронки запроса отзыва. Порядок значений — порядок движения по воронке.
enum ReviewRequestStatus {
  NEW // владелец пометил заказ, оператор ещё не брался
  CALLING // звонили, не дозвонились — ждём следующей попытки
  LINK_SENT // ссылка у клиента, ждём его слова
  PROMISED // клиент обещал оставить отзыв
  FORGOT // обещал и пропал; отправлено напоминание
  READY_TO_CHECK // клиент говорит, что оставил, — нужна проверка
  CONFIRMED // отзыв засчитан
  DECLINED // клиент отказался
  GAVE_UP // исчерпаны попытки и сроки
}

/// Чем ушла ссылка на отзыв. SMS — основной путь, письмо — когда SMS не смогла.
enum ReviewLinkChannel {
  SMS
  EMAIL
}

/// Чем подтверждён отзыв. Различать обязательно: подтверждение по слову клиента не должно
/// выглядеть в статистике так же достоверно, как найденное в Google.
enum ReviewConfirmVia {
  GOOGLE_MATCH
  MANUAL
}

/// Запись в журнале запроса. Журнал только пополняется: «звонили трижды за неделю» должно быть
/// видно, а не стёрто последним статусом.
enum ReviewEventKind {
  CREATED
  CALL_NO_ANSWER
  CALL_TALKED
  CLAIMED
  LINK_SENT
  LINK_FAILED
  PROMISED
  REMINDED
  CONFIRMED
  DECLINED
  GAVE_UP
  LOCATION_CHANGED
  REOPENED
}

/// Пометка владельца о работе с клиентом по конкретному заказу (см. Order.marketingMark).
enum OrderMarketingMark {
  MUTED // не писать клиенту маркетинговые цепочки
  ASK_REVIEW // попросить у клиента отзыв (задача колл-центру)
}

enum TelegramBotPurpose {
  OWNER
  FLORIST
  CUSTOMER_SERVICE
}

enum TelegramAudience {
  FLORIST
  OWNER
  CUSTOMER_SERVICE
}

enum SiteSyncStatus {
  RUNNING
  DONE
  ERROR
}

// ─────────────────────────────  ПОЛЬЗОВАТЕЛИ  ─────────────────────────────

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  phone        String?
  role         Role
  telegramId   String?
  active       Boolean  @default(true)
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  florist            Florist?
  orderAudits        OrderAudit[]
  reviewEvents       ReviewRequestEvent[]
  reviewsConfirmed   OrderReviewRequest[] @relation("ReviewConfirmedBy")
  financeAudits      FinanceAudit[]
  ledgerEntriesAdded LedgerEntry[]

  @@index([role])
}

// Профиль флориста (привязан к User с ролью FLORIST).
model Florist {
  id                String                   @id @default(cuid())
  userId            String                   @unique
  user              User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  active            Boolean                  @default(true)
  financeVisibility FloristFinanceVisibility @default(MAKER_ONLY)
  avatarUrl         String? // ссылка на маленькую аватарку (public/uploads); загружает владелец

  /// Выходные по дням недели: 0 = воскресенье … 6 = суббота (как getUTCDay).
  /// Массивом, а не таблицей: значений максимум семь, и join ради них дороже пользы.
  weekendDays Int[]      @default([])
  /// Отдельные даты недоступности (отпуск, больничный). UTC-полночь БИЗНЕС-дня —
  /// та же конвенция, что у Order.deliveryDate; сравнение идёт день в день, без таймзон.
  daysOff     DateTime[] @default([])

  createdAt DateTime @default(now())

  sitePriorities  SiteFloristPriority[]
  productPrices   FloristProductPrice[]
  currentOrders   Order[]                 @relation("CurrentFlorist")
  assignments     OrderAssignment[]
  pickupLocations FloristPickupLocation[]
  telegramBot     TelegramBot?
  deliveries      Delivery[]              @relation("DeliveryFlorist")

  // ── Финансы (Stage 2) ──
  ledgerEntries      LedgerEntry[]
  financeProfiles    FloristFinanceProfile[]
  financeIssues      FinanceIssue[]
  additionalExpenses OrderAdditionalExpense[]
}

// ─────────────────────────────  САЙТЫ  ─────────────────────────────

model Site {
  id               String           @id @default(cuid())
  name             String
  shortName        String
  platform         Platform
  connectionStatus ConnectionStatus @default(PENDING)
  logo             String?
  colorTag         String           @default("#64748b")
  createdAt        DateTime         @default(now())

  // LEGACY (старый общий OAuth-app): специфичные для магазина поля, полученные при установке.
  // Для нового режима CUSTOM_APP не используются — там всё в зашифрованных полях ниже.
  shopifyShopDomain  String? @unique // "example.myshopify.com"
  shopifyAccessToken String? // shpat_... — LEGACY plain-text (общий OAuth); CUSTOM_APP использует accessTokenEncrypted
  timezone           String? // IANA-таймзона магазина (из Shopify shop.json) — для «сегодня» в списке закупки

  // ── CUSTOM APP (Dev Dashboard app + client_credentials, отдельное приложение на магазин) ──
  // Все секреты — ТОЛЬКО в зашифрованном виде (AES-256-GCM, см. lib/crypto/secretBox).
  authMode                      ShopifyAuthMode? // CUSTOM_APP для новых подключений; null = LEGACY
  normalizedShopDomain          String? // канонический "*.myshopify.com" — идентификатор магазина
  clientIdEncrypted             String?
  clientSecretEncrypted         String?
  clientSecretMask              String? // "********abcd" — для UI без расшифровки
  // Окно ротации Client Secret: старый secret валиден для входящих webhook до previousSecretValidUntil.
  previousClientSecretEncrypted String?
  previousSecretValidUntil      DateTime?
  accessTokenEncrypted          String?
  accessTokenMask               String? // маска токена для UI без расшифровки
  accessTokenExpiresAt          DateTime? // client_credentials: now + 86399s
  apiVersion                    String? // напр. "2026-07"
  grantedScopes                 String[]           @default([]) // фактические scopes из Shopify (не из формы)
  lastConnectionCheckAt         DateTime?
  lastSyncAt                    DateTime?
  shopifyConnStatus             ShopifyConnStatus? // CONNECTING|CONNECTED|DEGRADED|REAUTH_REQUIRED|DISCONNECTED
  connectionError               String? // безопасный текст (без секретов)

  floristPriorities SiteFloristPriority[]
  products          Product[]
  orders            Order[]
  syncs             SiteSync[]
  webhooks          ShopifyWebhook[]
  // WooCommerce: платформенные credentials/настройки вынесены в отдельную 1:1 модель
  // (Shopify-поля выше НЕ переносятся и не рефакторятся).
  wooConnection     WooCommerceConnection?
  wooWebhooks       WooCommerceWebhook[]

  // ── Burq автосоздание черновиков доставки ──
  burqDraftAutoCreateEnabled     Boolean @default(false)
  burqDraftCreationLocalTime     String  @default("04:00") // локальное время (HH:mm) утреннего создания черновиков
  automationDailyLocalTime       String  @default("08:00") // "HH:mm" локального времени ежедневных триггеров автоматизаций (напр. «Доставка сегодня»)
  // Единый текст dropoff-инструкций магазина, автоматически добавляемый во все новые Burq draft.
  // Пусто/NULL → стандартная инструкция выключена (отдельный boolean не нужен).
  burqDefaultDropoffInstructions String?

  /**
   * Домен Email Factory, от имени которого магазин пишет клиентам вручную. Хранится ЗДЕСЬ, рядом
   * с quo*-полями, а не в SiteEmailSettings: там настройки Brevo, и один адрес на два независимых
   * канала означал бы, что включение рассылок молча меняет обратный адрес переписки.
   * null = не выбран. Когда домен в Email Factory ровно один, он берётся и без выбора — настройка
   * нужна там, где доменов несколько и промах отправил бы письмо с чужого адреса.
   */
  emailFactoryDomain String?

  // ── QUO (ex-OpenPhone): номер магазина для исходящих SMS ──
  quoPhoneNumberId   String? // QUO phone number id (PN…) — используется как `from` при отправке
  quoPhoneNumber     String? // E.164 номер магазина (для отображения и storePhone)
  quoEnabled         Boolean   @default(false) // QUO включён для магазина (гейт исходящих/входящих)
  quoLastCheckAt     DateTime? // время последней успешной проверки подключения к QUO
  quoConnectionError String? // безопасный текст ошибки последней проверки (без секретов)

  // ── SMS-маркетинг ──
  reviewUrl       String? // ссылка на отзыв для {{review_url}}; пусто → review-правила не отправляются
  automationSites AutomationSite[]

  // ── Automation Flows (цепочки шагов) ──
  automationFlowSites AutomationFlowSite[]
  automationFlowRuns  AutomationFlowRun[]

  // ── Email-рассылки (Brevo) — настройки, КЛЮЧ и статус проверки СВОИ у каждого магазина ──
  emailSettings      SiteEmailSettings?
  emailTemplates     SiteEmailTemplate[]
  integrationSecrets IntegrationSecret[]
  brevoStatus        BrevoAccountStatus?

  // ── Финансы: магазины, на которые распространяется профиль флориста ──
  financeProfileSites FloristFinanceProfileSite[]

  // ── Финансы: настройки расчёта доли основного флориста (Stage 3a) ──
  consumablesRates   ConsumablesRate[]
  acquiringFeeModels SiteAcquiringFeeModel[]
  ownerTaxPolicies   OwnerTaxPolicy[]
  financeIssues      FinanceIssue[]
  googleLocations    GoogleLocation[]
  reviewSettings     SiteReviewSettings?

  // Запрет двух активных Site одного платформенного домена (двойное подключение).
  @@unique([platform, normalizedShopDomain])
}

// Прогресс фоновой синхронизации по сайту и типу (товары/заказы). Одна актуальная
// строка на (siteId, kind) — обновляется по ходу импорта, читается UI для прогресса.
model SiteSync {
  id           String         @id @default(cuid())
  siteId       String
  site         Site           @relation(fields: [siteId], references: [id], onDelete: Cascade)
  kind         SyncKind
  status       SiteSyncStatus @default(RUNNING)
  total        Int? // всего к обработке, если известно (для «X из Y»)
  processed    Int            @default(0)
  created      Int            @default(0)
  updated      Int            @default(0)
  skipped      Int            @default(0)
  errors       Int            @default(0)
  errorMessage String?
  startedAt    DateTime       @default(now())
  finishedAt   DateTime?

  @@unique([siteId, kind])
  @@index([siteId])
}

// Упорядоченный список приоритетов флористов для конкретного сайта.
// position 0 = основной, дальше по возрастанию — резервные.
model SiteFloristPriority {
  id        String  @id @default(cuid())
  siteId    String
  site      Site    @relation(fields: [siteId], references: [id], onDelete: Cascade)
  floristId String
  florist   Florist @relation(fields: [floristId], references: [id], onDelete: Cascade)
  position  Int

  @@unique([siteId, floristId])
  @@unique([siteId, position])
  @@index([siteId])
}

// ─────────────────────────────  ТОВАРЫ И ЦЕНЫ  ─────────────────────────────

// Карточка товара (агрегат). Точные цены сайта живут в ProductVariant;
// здесь только агрегаты minPrice/maxPrice по активным неудалённым вариантам.
model Product {
  id                           String             @id @default(cuid())
  name                         String
  image                        String?
  defaultFloristComposition    String? // шаблон состава букета; НЕ используется в заказе напрямую (только для заполнения вариантов)
  siteId                       String
  site                         Site               @relation(fields: [siteId], references: [id], onDelete: Cascade)
  externalId                   String // Shopify product id
  status                       ProductStatus      @default(ACTIVE) // источник истины — Shopify
  productType                  String?
  adminUrl                     String? // ссылка на товар в Shopify Admin (у Woo сюда пишется permalink витрины)
  onlineUrl                    String? // публичная ссылка на товар в витрине магазина (Woo: permalink, Shopify: /products/{handle})
  floristPrice                 Decimal?           @db.Decimal(10, 2) // базовая себестоимость; NULL = не задана → флорист получает полную стоимость заказа
  minPrice                     Decimal?           @db.Decimal(10, 2) // агрегат по активным вариантам
  maxPrice                     Decimal?           @db.Decimal(10, 2)
  // ── Финансовая классификация. Задаёт ТОЛЬКО владелец; синхронизация не трогает. ──
  // productType (simple/variable) финансовым типом НЕ является и здесь не участвует.
  financialType                FinancialItemType? // значение по умолчанию для вариантов; NULL = не задано
  defaultIncludesVase          Boolean? // NULL = не задано; варианты наследуют это значение
  // Ваза по умолчанию для вариантов — ССЫЛКА на вариант настоящего товара-вазы.
  // Закупочная стоимость здесь не хранится: она живёт у самой вазы (VasePurchaseCost).
  defaultIncludedVaseVariantId String?
  defaultIncludedVaseVariant   ProductVariant?    @relation("ProductDefaultVase", fields: [defaultIncludedVaseVariantId], references: [id], onDelete: SetNull)
  remoteDeleted                Boolean            @default(false) // пропал из внешнего API
  deletedAt                    DateTime?
  lastSyncedAt                 DateTime?
  lastSeenSyncRunId            String? // id последнего sync-прогона, где товар встретился (для безопасной пометки remoteDeleted только после DONE)
  createdAt                    DateTime           @default(now())
  updatedAt                    DateTime           @updatedAt

  variants      ProductVariant[]
  floristPrices FloristProductPrice[]
  vaseCosts     VasePurchaseCost[]

  @@unique([siteId, externalId])
  @@index([siteId])
  @@index([financialType])
  @@index([defaultIncludedVaseVariantId])
}

// Конкретная вариация товара (Shopify variant). Хранится отдельно от Product
// для единой модели даже при единственном варианте "Default Title".
model ProductVariant {
  id                    String             @id @default(cuid())
  productId             String
  product               Product            @relation(fields: [productId], references: [id], onDelete: Cascade)
  externalId            String // Shopify variant id
  title                 String // напр. "Small / Red" или "Default Title"
  sku                   String?
  listPrice             Decimal            @db.Decimal(10, 2) // цена сайта
  compareAtPrice        Decimal?           @db.Decimal(10, 2)
  image                 String?
  option1               String?
  option2               String?
  option3               String?
  inventoryQty          Int? // если доступно текущими scopes
  available             Boolean            @default(true) // статус доступности
  floristComposition    String? // локальный состав букета для флориста (многострочный текст) — Shopify не трогает
  floristPrice          Decimal?           @db.Decimal(10, 2) // необязательная цена флориста для варианта
  // ── Финансовая классификация варианта. Приоритетнее товара; синхронизация не трогает. ──
  financialType         FinancialItemType? // NULL = наследовать Product.financialType
  // ТРИ состояния, поэтому Boolean? и БЕЗ @default:
  //   NULL  — наследовать Product.defaultIncludesVase (или неизвестно, если и там NULL)
  //   true  — букет с включённой вазой
  //   false — подтверждённо БЕЗ вазы (не то же самое, что «не знаем»)
  includesVase          Boolean?
  // Конкретная ваза внутри букета. Приоритетнее товарного дефолта. Стоимость не дублируется:
  // расчёт берёт VasePurchaseCost связанной вазы на дату доставки.
  includedVaseVariantId String?
  includedVaseVariant   ProductVariant?    @relation("VariantIncludedVase", fields: [includedVaseVariantId], references: [id], onDelete: SetNull)
  financialTypeSetBy    String? // User.id последнего изменения классификации
  financialTypeSetAt    DateTime?
  position              Int?
  adminUrl              String? // ссылка на вариант в Admin, если доступна
  lastSyncedAt          DateTime?
  lastSeenSyncRunId     String? // см. Product.lastSeenSyncRunId
  remoteDeleted         Boolean            @default(false)
  deletedAt             DateTime?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  floristPrices          FloristProductPrice[]
  vaseCosts              VasePurchaseCost[]
  // Обратные связи: на карточке вазы видно, где она используется.
  usedAsIncludedVaseBy   ProductVariant[]      @relation("VariantIncludedVase")
  usedAsProductDefaultBy Product[]             @relation("ProductDefaultVase")

  @@unique([productId, externalId])
  @@index([productId])
  @@index([financialType])
  @@index([includesVase])
  @@index([includedVaseVariantId])
}

// Финансовый тип позиции. Единый на весь проект: каталог и будущий финансовый модуль
// используют ОДИН enum, чтобы классификация товара и классификация строки заказа не разъехались.
enum FinancialItemType {
  FLOWER_PRODUCT
  VASE
  TIP
  DELIVERY
  TAX
  SERVICE_FEE
  DISCOUNT
  CARD
  GIFT
  OTHER
}

enum VaseCostType {
  STANDALONE_VASE // товар/вариант САМ является вазой (financialType = VASE)
  INCLUDED_VASE // ваза внутри букета (FLOWER_PRODUCT + includesVase = true)
}

/// Закупочная себестоимость вазы с датами действия — ЕДИНСТВЕННЫЙ источник стоимости.
/// Кэширующей колонки на варианте нет специально: вторая точка правды рано или поздно разъедется.
///
/// Цель ровно одна: заполнен либо productId, либо productVariantId (CHECK в миграции).
/// Пересечение периодов по одной цели и costType запрещено exclusion-constraint'ом.
/// Отсутствие подходящей записи = «стоимость неизвестна» (VASE_COST_MISSING),
/// а purchaseCostCents = 0 — подтверждённая нулевая себестоимость.
model VasePurchaseCost {
  id                String       @id @default(cuid())
  productId         String?
  productVariantId  String?
  costType          VaseCostType
  purchaseCostCents Int // >= 0, проверяется CHECK
  currency          String       @default("USD")
  comment           String?
  createdBy         String // User.id
  createdAt         DateTime     @default(now())

  product Product?        @relation(fields: [productId], references: [id], onDelete: Restrict)
  variant ProductVariant? @relation(fields: [productVariantId], references: [id], onDelete: Restrict)

  /// Одна цена на цель и тип. Частичные уникальные индексы — в миграции: цель задана
  /// либо вариантом, либо товаром, и NULL во второй колонке не должен снимать проверку.
  @@index([productVariantId, costType])
  @@index([productId, costType])
}

/// Общий финансовый аудит. Заводится этой миграцией для каталога и переиспользуется
/// финансовым модулем. История не удаляется и не переписывается.
model FinanceAudit {
  id                    String   @id @default(cuid())
  entity                String // "Product" | "ProductVariant" | "VasePurchaseCost"
  entityId              String
  action                String // SET_TYPE | SET_INCLUDES_VASE | SET_COST | RESET_TO_INHERIT | BULK_CLASSIFY
  beforeJson            Json?
  afterJson             Json?
  reason                String? // обязателен для bulk-операций (проверяется сервисом)
  batchId               String? // одна bulk-операция = один batchId на все строки
  // Снимки названий: отчёт остаётся читаемым, даже если товар пропал с платформы.
  entityNameSnapshot    String?
  siteShortNameSnapshot String?
  userId                String
  role                  Role
  createdAt             DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([entity, entityId, createdAt])
  @@index([batchId])
  @@index([userId, createdAt])
}

// Индивидуальный override цены флориста. variantId = null → override на весь товар;
// заданный variantId → override на конкретный вариант. Приоритет резолва — см.
// modules/pricing/service.ts. UI для флорист-оверрайдов пока не строится (задел на будущее).
model FloristProductPrice {
  id        String          @id @default(cuid())
  productId String
  product   Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId String?
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)
  floristId String
  florist   Florist         @relation(fields: [floristId], references: [id], onDelete: Cascade)
  makeCost  Decimal         @db.Decimal(10, 2)

  @@unique([floristId, productId, variantId])
  @@index([productId])
  @@index([variantId])
}

// ───────────────────  ФИНАНСЫ: LEDGER И ВЫПЛАТЫ (Stage 2)  ───────────────────
//
// Единственный источник правды по деньгам флориста — LedgerEntry. Мутируемого поля
// «сколько должны» не существует НИГДЕ: баланс всегда складывается из записей.
// Все суммы здесь — целые центы (Int), Decimal в новых финансовых таблицах не появляется.

enum FinanceModel {
  PRIMARY // доля от прибыли за период (расчёт — Stage 3)
  SECONDARY // фиксированная цена изготовления по доставленным заказам
}

enum FinanceScope {
  ALL_SITES
  SELECTED_SITES
}

enum LedgerEntryType {
  ORDER_ACCRUAL // начисление за доставленный заказ
  PRIMARY_FLORIST_SHARE // доля основного флориста за период (наполняет Stage 3)
  BONUS
  DEDUCTION
  PAYMENT
  PAYMENT_REVERSAL // отмена ошибочной выплаты
  MANUAL_ADJUSTMENT // ручная правка владельца, не исправляющая конкретную запись
  CORRECTION // сторно/исправление ранее опубликованной записи
}

/// CREDIT увеличивает долг перед флористом, DEBIT уменьшает.
/// Баланс = Σ CREDIT − Σ DEBIT. Знака у amountCents нет и быть не должно:
/// иначе одна и та же операция выражалась бы двумя способами.
enum LedgerDirection {
  CREDIT
  DEBIT
}

/// Append-only книга операций по флористу.
///
/// UPDATE и DELETE запрещены ТРИГГЕРОМ В БД (см. миграцию), а не только договорённостью:
/// ORM, ad-hoc скрипт и psql получают одну и ту же ошибку. Поэтому у модели намеренно нет
/// `updatedAt` — обновлять строку физически нельзя. Исправление оформляется НОВОЙ записью
/// с `reversedEntryId`.
///
/// `financePeriodId` здесь СОЗНАТЕЛЬНО отсутствует: колонка без таблицы — висячая ссылка.
/// Stage 3 добавит FinancePeriod и нормальный FK одной миграцией.
model LedgerEntry {
  id        String  @id @default(cuid())
  floristId String
  florist   Florist @relation(fields: [floristId], references: [id], onDelete: Restrict)

  // Restrict, а не Cascade: удаление заказа не имеет права стирать историю денег.
  orderId String?
  order   Order?  @relation(fields: [orderId], references: [id], onDelete: Restrict)

  type      LedgerEntryType
  direction LedgerDirection

  /// Целые центы, всегда >= 0. Ноль — ПОДТВЕРЖДЁННОЕ решение «за этот заказ не платим»;
  /// «не решено» выражается отсутствием записи. Тот же принцип, что у VasePurchaseCost.
  amountCents Int
  currency    String @default("USD")

  /// Бизнес-дата операции. Для ORDER_ACCRUAL — Order.deliveryDate, то есть UTC-полночь
  /// ЛОКАЛЬНОГО дня доставки (см. CLAUDE.md: через таймзону её пересчитывать нельзя).
  effectiveDate DateTime

  description String // короткая машинно-стабильная строка: «Заказ FLWBR-91154»
  comment     String? // свободный комментарий владельца; флорист его ВИДИТ

  createdBy     String // User.id
  createdByUser User     @relation(fields: [createdBy], references: [id], onDelete: Restrict)
  createdByRole Role // снимок роли на момент записи
  createdAt     DateTime @default(now())

  sourceType    String // "ORDER" | "MANUAL" | "PERIOD" | "REVERSAL"
  sourceId      String? // orderId | reversedEntryId | periodId
  sourceVersion Int     @default(1) // версия правила расчёта

  idempotencyKey String @unique

  /// Какую запись сторнирует эта. Unique — одну запись нельзя сторнировать дважды.
  reversedEntryId String?      @unique
  reversedEntry   LedgerEntry? @relation("Reversal", fields: [reversedEntryId], references: [id], onDelete: Restrict)
  reversal        LedgerEntry? @relation("Reversal")

  metadata Json? // служебное (провенанс суммы и т.п.); флористу НЕ отдаётся

  // Снимки: отчёт остаётся читаемым, даже если заказ уедет из выборки.
  floristNameSnapshot String
  orderNumberSnapshot String?

  /// Ревизии снимков, из которых собрано начисление. У дневной доли основного флориста
  /// их много (по снимку на каждый заказ дня), поэтому связь многие-ко-многим.

  @@index([floristId, effectiveDate])
  @@index([floristId, type, effectiveDate])
  @@index([orderId])
  @@index([createdAt])
}

/// Effective-dated финансовый профиль флориста.
///
/// НЕ имеет отношения к `Florist.financeVisibility`: та настройка про то, какие суммы
/// заказа видит флорист, и заодно используется как приоритет авто-назначения. Модель
/// оплаты из неё не выводится и на неё не влияет.
model FloristFinanceProfile {
  id        String  @id @default(cuid())
  floristId String
  florist   Florist @relation(fields: [floristId], references: [id], onDelete: Restrict)

  model FinanceModel

  /// Доля в БАЗИСНЫХ ПУНКТАХ: 66.6% = 6660. Проценты дробные, а Float в деньгах не заводим.
  /// Только для PRIMARY; у SECONDARY обязан быть NULL (CHECK в миграции).
  sharePercentBp Int?

  scope         FinanceScope                @default(ALL_SITES)
  sites         FloristFinanceProfileSite[]
  flowerExpense DailyFlowerExpense[]
  dayFinances   DayFinance[]

  effectiveFrom DateTime
  effectiveTo   DateTime? // NULL = действует сейчас; если задан — строго > effectiveFrom (CHECK)
  active        Boolean   @default(true)

  comment   String?
  createdBy String // User.id
  createdAt DateTime @default(now())

  @@index([floristId, effectiveFrom])
  @@index([effectiveTo])
}

/// Магазины профиля при scope = SELECTED_SITES. При ALL_SITES строк нет.
model FloristFinanceProfileSite {
  id        String                @id @default(cuid())
  profileId String
  profile   FloristFinanceProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  siteId    String
  site      Site                  @relation(fields: [siteId], references: [id], onDelete: Restrict)

  @@unique([profileId, siteId])
}

// ───────────  ФИНАНСЫ: ВХОДНЫЕ ДАННЫЕ РАСЧЁТА ДОЛИ (Stage 3a)  ───────────
//
// Всё, из чего складывается распределяемая прибыль заказа основного флориста.
// Отсутствие строки везде означает «неизвестно», а не ноль: подставлять ноль в
// расход — значит завысить прибыль и переплатить долю.

/// Дневная закупка цветов. Распределяется ТОЛЬКО между доставленными заказами
/// основного флориста этого дня, пропорционально цветочной части заказа.
///
/// Ключ — профиль, а не глобальный день: основной флорист сейчас один, но при смене
/// PRIMARY или появлении второго профиля глобальный unique стал бы миграционным тупиком.
/// Профиль дня резолвится по expenseDay, поэтому пара (профиль, день) однозначна.
model DailyFlowerExpense {
  id               String                @id @default(cuid())
  financeProfileId String
  financeProfile   FloristFinanceProfile @relation(fields: [financeProfileId], references: [id], onDelete: Restrict)
  /// UTC-полночь ЛОКАЛЬНОГО дня — та же конвенция, что у Order.deliveryDate.
  expenseDay       DateTime
  amountCents      Int // >= 0, CHECK
  currency         String                @default("USD")
  comment          String?
  createdBy        String
  createdAt        DateTime              @default(now())
  /// Кто правил последним. NULL — с момента создания не менялась.
  /// Автор создания хранится отдельно и правкой не затирается: у строки, из-за которой
  /// изменилась чужая выплата, должно быть видно обоих.
  updatedBy        String?
  updatedAt        DateTime              @updatedAt

  @@unique([financeProfileId, expenseDay])
  @@index([expenseDay])
  /// Постраничный вывод всей истории профиля по убыванию дня.
  @@index([financeProfileId, expenseDay])
}

/// Ставка расходников на один доставленный заказ, с датами действия.
model ConsumablesRate {
  id          String   @id @default(cuid())
  /// NULL = глобальная ставка; заданный siteId переопределяет её для магазина.
  siteId      String?
  site        Site?    @relation(fields: [siteId], references: [id], onDelete: Restrict)
  amountCents Int // >= 0
  comment     String?
  createdBy   String
  createdAt   DateTime @default(now())

  /// Одна строка на область. Уникальность глобальной строки держит частичный индекс в
  /// миграции: NULL в обычном уникальном индексе не сравнивается сам с собой.
  @@unique([siteId])
}

/// Ручная поправка расходников по конкретному заказу — перебивает ставку.
model OrderConsumablesOverride {
  id          String   @id @default(cuid())
  orderId     String   @unique
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Restrict)
  amountCents Int // >= 0
  comment     String?
  createdBy   String
  createdAt   DateTime @default(now())
}

enum AcquiringFeeSource {
  ACTUAL // фактическая комиссия провайдера
  ESTIMATED // расчёт по модели магазина
}

/// Модель комиссии эквайринга магазина: процент + фиксированная часть.
/// Применяется, когда фактической комиссии по заказу нет.
model SiteAcquiringFeeModel {
  id         String   @id @default(cuid())
  siteId     String   @unique
  site       Site     @relation(fields: [siteId], references: [id], onDelete: Restrict)
  /// Базисные пункты: 2.9% = 290. Float в деньгах не заводим.
  percentBp  Int
  fixedCents Int
  comment    String?
  createdBy  String
  createdAt  DateTime @default(now())
}

/// Фактическая комиссия по заказу. Отсутствие строки = «неизвестна», тогда
/// применяется модель магазина и расчёт помечается ESTIMATED.
model OrderAcquiringFee {
  id         String   @id @default(cuid())
  orderId    String   @unique
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Restrict)
  feeCents   Int // >= 0
  provider   String // "AIRWALLEX" | "SHOPIFY_PAYMENTS" | ...
  externalId String?
  createdBy  String // "system:airwallex" либо User.id
  createdAt  DateTime @default(now())
}

/// Доля Order.tax, являющаяся РЕАЛЬНЫМ расходом владельца.
/// Флористам не отдаётся никогда: в их базе налог вычитается на 100%.
model OwnerTaxPolicy {
  id            String   @id @default(cuid())
  siteId        String? // NULL = глобальная политика
  site          Site?    @relation(fields: [siteId], references: [id], onDelete: Restrict)
  /// Базисные пункты от Order.tax: 20% = 2000.
  actualShareBp Int
  comment       String?
  createdBy     String
  createdAt     DateTime @default(now())

  @@unique([siteId])
}

/// Дополнительный расход по заказу: повторная доставка, переделка букета, компенсация.
///
/// Отменяется, а не удаляется, как только поучаствовал в расчёте: строка, по которой уже
/// начислены или удержаны деньги, обязана остаться объяснением этих денег. Пока расчёт до
/// неё не дошёл, физическое удаление безопасно и разрешено.
///
/// `floristIdSnapshot` фиксируется в момент создания и НЕ переносится при переназначении
/// заказа: расход несёт тот, кто выполнял заказ тогда, а не тот, кому заказ достался потом.
/// Пользователь его не выбирает и не видит — поле техническое.
model OrderAdditionalExpense {
  id                String   @id @default(cuid())
  orderId           String
  order             Order    @relation(fields: [orderId], references: [id], onDelete: Restrict)
  amountCents       Int // > 0, CHECK
  description       String
  /// Дата возникновения расхода. На расчёт PRIMARY не влияет — там расход принадлежит
  /// дню доставки заказа; используется как дата удержания у SECONDARY и для отчётности.
  expenseDate       DateTime
  floristIdSnapshot String
  florist           Florist  @relation(fields: [floristIdSnapshot], references: [id], onDelete: Restrict)

  createdBy      String
  createdAt      DateTime  @default(now())
  updatedBy      String?
  updatedAt      DateTime  @updatedAt
  /// Отменён: в итог не входит и в расчёте не участвует. История при этом сохраняется.
  reversedAt     DateTime?
  reversedBy     String?
  reversalReason String?

  @@index([orderId])
  @@index([floristIdSnapshot, reversedAt])
}

/// Финансовый итог дня основного флориста.
///
/// ОДНА строка на (профиль, день), и она ИЗМЕНЯЕМАЯ: это всегда текущий расчёт, а не
/// история. Ревизий, статусов и жизненного цикла здесь нет намеренно — предыдущая модель
/// замораживала расчёт при каждом пересчёте и накапливала ленту «вытеснено», которая
/// ничего не объясняла.
///
/// Замораживается не расчёт, а ДЕНЬГИ: в момент начисления цифры дня копируются в
/// LedgerEntry.calcJson. Книга и так append-only, поэтому чек там неизменяем бесплатно, а
/// история дня становится историей движения денег: начислено → сторно → начислено заново.
///
/// Дневная закупка цветов лежит здесь ПРЯМО, без распределения по заказам: она и есть
/// расход дня. Раскладывать её по заказам и собирать обратно было нужно только потому,
/// что расчёт хранился в позаказных строках.
model DayFinance {
  id               String                @id @default(cuid())
  financeProfileId String
  financeProfile   FloristFinanceProfile @relation(fields: [financeProfileId], references: [id], onDelete: Cascade)
  /// UTC-полночь ЛОКАЛЬНОГО дня доставки — та же конвенция, что у Order.deliveryDate.
  day              DateTime

  /// Заполнены ли ВСЕ заказы дня. День считается целиком или не считается вовсе.
  complete    Boolean
  /// Почему не считается: коды недостающих данных. Пусто у полного дня.
  blockers    String[]
  ordersTotal Int

  // ── Суммы дня, целые центы ──
  grossRevenueCents   Int
  tipsCents           Int
  taxCents            Int
  deliveryCents       Int
  acquiringFeeCents   Int
  vaseGiftCostCents   Int
  consumablesCents    Int
  /// Дневная закупка цветов: расход дня, а не сумма позаказных долей.
  flowerPurchaseCents Int
  additionalCents     Int
  distributableCents  Int

  /// Детализация по заказам — как ДАННЫЕ, а не как отдельные строки со своей жизнью.
  /// Нужна редко: «что-то пошло не так», разбор полётов.
  ordersJson Json

  updatedBy String
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@unique([financeProfileId, day])
  @@index([day])
}

// ───────────────  FINANCE SETUP ASSISTANT (Stage 3a)  ───────────────

enum FinanceIssueSeverity {
  BLOCKING // расчёт невозможен: заказ либо весь день не участвует
  WARNING // расчёт возможен, но приблизителен
  INFO // к сведению, на деньги не влияет
}

enum FinanceIssueStatus {
  OPEN
  RESOLVED // владелец исправил из очереди
  AUTO_RESOLVED // проблема исчезла сама при изменении данных
  DISMISSED // владелец сознательно закрыл без исправления
}

enum FinanceIssueType {
  DELIVERY_ACTUAL_COST_MISSING
  ACQUIRING_FEE_MODEL_MISSING
  DAILY_FLOWER_EXPENSE_MISSING
  VASE_COST_MISSING
  GIFT_COST_MISSING
  VASE_LINK_MISSING
  CONSUMABLES_RATE_MISSING
  OWNER_TAX_POLICY_MISSING
  /// Цветочную выручку хотя бы одного заказа дня определить нельзя, поэтому
  /// знаменатель распределения недостоверен. Блокирует ВЕСЬ день: посчитать по
  /// заведомо неверному знаменателю хуже, чем не считать вовсе.
  FLOWER_REVENUE_UNDETERMINED
}

enum FinanceActionType {
  SET_DELIVERY_ACTUAL_COST
  CREATE_SITE_FEE_MODEL
  SET_DAILY_FLOWER_EXPENSE
  SET_VASE_PURCHASE_COST
  LINK_VASE_VARIANT
  SET_CONSUMABLES_RATE
  SET_OWNER_TAX_POLICY
  /// Быстрого исправления нет: нужно разметить позиции в каталоге вручную.
  CLASSIFY_ORDER_ITEMS
}

/// Проблема, мешающая расчёту доли.
///
/// ИЗМЕНЯЕМАЯ — в отличие от LedgerEntry: это рабочая очередь, а не деньги, и повторный
/// прогон детектора обязан обновлять строку, а не плодить новые. Факт наличия проблемы
/// определяет ДЕТЕКТОР при каждом прогоне; таблица хранит личность, предложение и разбор.
/// Всё, что перестало находиться, закрывается как AUTO_RESOLVED.
///
/// Область блокировки выводится из type (заказ / день / все заказы) и отдельной колонкой
/// не дублируется — иначе получилось бы два ответа на один вопрос.
model FinanceIssue {
  id       String               @id @default(cuid())
  type     FinanceIssueType
  severity FinanceIssueSeverity
  status   FinanceIssueStatus   @default(OPEN)

  /// Личность проблемы: повторное обнаружение обновляет строку.
  deduplicationKey String @unique

  /// Дата, к которой относится проблема (доставка заказа либо день закупки) —
  /// по ней работает группировка «Сегодня / 7 дней / Старое».
  scopeDate DateTime?

  siteId    String?
  site      Site?    @relation(fields: [siteId], references: [id], onDelete: Restrict)
  orderId   String?
  order     Order?   @relation(fields: [orderId], references: [id], onDelete: Restrict)
  floristId String?
  florist   Florist? @relation(fields: [floristId], references: [id], onDelete: Restrict)

  /// На что указывает проблема: "Order" | "ProductVariant" | "Site" | "Day" | "Global".
  sourceEntity   String
  sourceEntityId String

  suggestedActionType  FinanceActionType
  /// Предложенное значение, если его можно вычислить (напр. оценка Burq). NULL — нельзя.
  suggestedValueJson   Json?
  /// Контекст карточки: чего не хватает, сколько заказов затронуто, цветочная выручка дня.
  detailJson           Json?
  /// Прогноз влияния на расчёт. NULL означает «неизвестно» и показывается именно так:
  /// без кандидатского значения посчитать эффект нельзя, а ноль соврал бы.
  estimatedImpactCents Int?

  firstDetectedAt   DateTime  @default(now())
  lastDetectedAt    DateTime  @default(now())
  resolvedAt        DateTime?
  resolvedBy        String? // User.id
  resolutionComment String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, severity, scopeDate])
  @@index([status, siteId])
  @@index([status, type])
  @@index([orderId])
}

// ─────────────────────────────  ЗАКАЗЫ  ─────────────────────────────

model Order {
  id          String @id @default(cuid())
  orderNumber String @unique

  siteId String
  site   Site   @relation(fields: [siteId], references: [id])
  source String // источник заказа (напр. "Website", "Phone")

  // Даты
  externalCreatedAt DateTime // дата создания заказа на сайте
  deliveryDate      DateTime
  deliveryWindow    String // напр. "14:00 – 18:00"

  // Отправитель (billing). Адрес — из Shopify billing_address (двусторонним НЕ является: показываем
  // как есть; при повторной синхронизации не обнуляем). Отдельно от адреса получателя (shipping).
  senderName        String
  senderPhone       String
  senderEmail       String?
  senderAddressLine String?
  senderApartment   String?
  senderCity        String?
  senderProvince    String? // province_code (напр. "OR")
  senderZip         String?
  senderCountry     String? // country_code (напр. "US")

  // Инструкции доставки — native Shopify Local Delivery (Additional details → Delivery instructions).
  // Источник: GraphQL Order.fulfillmentOrders → deliveryMethod.additionalInformation.instructions.
  // НЕ путать с cardMessage (текст открытки) и customerNote (ручная заметка владельца/колл-центра).
  deliveryInstructions String @default("")

  // Получатель
  recipientName  String
  recipientPhone String
  recipientEmail String?
  addressLine    String
  apartment      String?
  city           String
  zip            String

  // Открытка и заметка — с оригиналами, автоматически не меняются
  cardMessage          String @default("")
  originalCardMessage  String @default("")
  /// ВНУТРЕННЯЯ заметка команды: владелец, колл-центр, флорист. На Woo сюда попадает и то,
  /// что заказчик написал при оформлении. НАРУЖУ НЕ УХОДИТ — курьеру предназначен courierNote.
  customerNote         String @default("")
  originalCustomerNote String @default("")
  /// Инструкция КУРЬЕРУ: единственное поле заказа, уезжающее в Burq (поверх стандартного
  /// текста магазина, Site.burqDefaultDropoffInstructions). Заполняется редко и вручную —
  /// обычно флористом перед вызовом курьера. Пусто — в запрос Burq не попадает вовсе.
  courierNote          String @default("")

  // Финансы (раздельно) — доступны только владельцу
  itemsTotal                    Decimal   @db.Decimal(10, 2)
  tax                           Decimal   @default(0) @db.Decimal(10, 2)
  tip                           Decimal   @default(0) @db.Decimal(10, 2)
  discount                      Decimal   @default(0) @db.Decimal(10, 2)
  deliveryCustomerCost          Decimal   @default(0) @db.Decimal(10, 2)
  customerTotal                 Decimal   @db.Decimal(10, 2)
  floristTotal                  Decimal   @default(0) @db.Decimal(10, 2) // снимок суммы флористу
  deliveryActualCost            Decimal   @default(0) @db.Decimal(10, 2)
  /// Владелец подтвердил фактическую стоимость доставки (в т.ч. нулевую — самовывоз).
  /// Нужно потому, что у deliveryActualCost есть default 0, и без этой отметки
  /// «доставка бесплатна» неотличимо от «стоимость неизвестна»: заказ с реально нулевой
  /// доставкой навсегда остался бы в очереди разбора.
  deliveryActualCostConfirmedAt DateTime?
  /// Откуда взялась сумма: "MANUAL" — владелец вписал руками в карточке заказа,
  /// "BURQ" — пришла от Burq (вебхук или массовое подтверждение). Нужно ровно для подписи в
  /// карточке: обе дороги пишут одно и то же поле и одну и ту же отметку подтверждения, и без
  /// признака через месяц не вспомнить, ноль поставил человек или это цифра курьера.
  deliveryActualCostSource      String?
  estimatedProfit               Decimal   @default(0) @db.Decimal(10, 2)

  // Пять раздельных статусов
  paymentStatus    PaymentStatus    @default(UNPAID)
  orderStatus      OrderStatus      @default(AWAITING_PAYMENT)
  assignmentStatus AssignmentStatus @default(UNASSIGNED)
  deliveryStatus   DeliveryStatus   @default(PENDING)
  syncStatus       SyncStatus       @default(LOCAL)

  // Назначенный флорист (снимок цены — в floristTotal и в позициях)
  currentFloristId String?
  currentFlorist   Florist?  @relation("CurrentFlorist", fields: [currentFloristId], references: [id])
  priceMode        PriceMode @default(AUTO)

  // Точка забора, выбранная оператором ВРУЧНУЮ именно для этого заказа. null = брать основную
  // точку назначенного флориста. Это РЕШЕНИЕ, а не снимок: что фактически ушло в Burq —
  // в Delivery.pickupLocationId конкретной попытки.
  pickupLocationOverrideId String?
  pickupLocationOverride   FloristPickupLocation? @relation("OrderPickupOverride", fields: [pickupLocationOverrideId], references: [id])

  // Производство и доставка
  readyAt          DateTime?
  bouquetPhotoUrl  String?
  deliveryPhotoUrl String?
  trackingUrl      String?

  // Синхронизация (готовим под интеграции)
  externalId        String?
  platform          Platform
  lastSyncedAt      DateTime?
  externalUpdatedAt DateTime? // Shopify updated_at / Woo date_modified_gmt — защита от out-of-order
  syncError         String?

  // Внешний статус и платёжные данные платформы (заполняются WooCommerce; Shopify не трогает).
  externalStatus        String? // сырой статус платформы: "pending" | "processing" | ...
  paymentMethod         String? // order.payment_method (напр. "airwallex_klarna")
  paymentMethodTitle    String? // order.payment_method_title (напр. "Klarna Pay Later")
  paymentClassification String? // результат classifyWooPayment: PAID|PAY_LATER_APPROVED|PAYMENT_PENDING|PAYMENT_FAILED|REFUNDED|UNKNOWN
  paymentWarning        String? // безопасное предупреждение владельцу (без PII), если статус неоднозначен
  // Внешнее удаление/архивация (order.deleted / trash): физически заказ НЕ удаляем.
  remoteDeleted         Boolean   @default(false)
  deletedAt             DateTime?

  // true — заказ подтянут разовым backfill-скриптом истории Shopify (не через
  // "живой" вебхук). Используется, чтобы показывать его в отдельной вкладке
  // "Старые заказы", а не смешивать с обычной лентой (см. scripts/backfill-shopify-orders.ts).
  isBackfilled Boolean @default(false)

  /// Пометка владельца о работе с клиентом по этому заказу. NULL — обычный заказ.
  /// MUTED — не писать клиенту маркетинговые цепочки (Marketing Flows). ASK_REVIEW — наоборот,
  /// попросить отзыв: колл-центр получает задачу в Telegram и видит пометку в карточке.
  /// Одно поле, а не два флага: значения взаимоисключающие — нельзя одновременно молчать
  /// и просить отзыв. Служебные уведомления (доставка сегодня, доставлен, трек) не зависят
  /// от пометки ни в одном из значений.
  marketingMark OrderMarketingMark?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items              OrderItem[]
  reviewRequest      OrderReviewRequest?
  assignments        OrderAssignment[]
  messages           Message[]
  communications     OrderCommunication[]
  emailMessages      OrderEmailMessage[]
  deliveryIntent     DeliveryIntent?
  deliveries         Delivery[]
  telegramMessages   TelegramMessage[]
  audits             OrderAudit[]
  automationJobs     AutomationJob[]
  automationFlowRuns AutomationFlowRun[]
  airwallexPayment   AirwallexPayment?
  airwallexChecks    AirwallexCheck[]
  ledgerEntries      LedgerEntry[]

  // ── Финансы Stage 3a ──
  consumablesOverride OrderConsumablesOverride?
  acquiringFee        OrderAcquiringFee?
  financeIssues       FinanceIssue[]
  additionalExpenses  OrderAdditionalExpense[]

  // NULL допустим много раз (Postgres: NULL != NULL) — не мешает заказам без внешнего источника.
  // Источник истины для идемпотентности вебхуков (см. ingestShopifyOrder) — не полагаемся
  // только на проверку в коде перед созданием.
  @@unique([siteId, externalId])
  @@index([siteId])
  @@index([deliveryDate])
  @@index([currentFloristId])
  @@index([orderStatus])
  @@index([isBackfilled])
}

model OrderItem {
  id                         String  @id @default(cuid())
  orderId                    String
  order                      Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  // Ссылки/снимки на товар и вариант. Свободные строки (не FK) — снимок должен
  // переживать физическое исчезновение товара/варианта; резолв цены — по этим id.
  productId                  String? // наш Product.id (для авто-цены)
  variantId                  String? // наш ProductVariant.id (для авто-цены варианта)
  productExternalId          String? // снимок Shopify product id
  variantExternalId          String? // снимок Shopify variant id
  name                       String // снимок названия товара
  variantName                String? // снимок названия варианта
  sku                        String? // снимок SKU
  // Снимки изображений. `image` — LEGACY «эффективное» изображение (variant ?? product):
  // сохранено для старых заказов, где разделить parent/variant задним числом невозможно.
  // Новые импорты пишут все три: parentImageUrl/variantImageUrl раздельно + image как прежде.
  image                      String? // legacy/effective snapshot — не удалять, читается как fallback
  parentImageUrl             String? // фото родительского товара (Product.image)
  variantImageUrl            String? // фото выбранной вариации (ProductVariant.image), если задано
  floristCompositionSnapshot String? // снимок состава варианта на момент заказа (не Shopify description)
  quantity                   Int     @default(1)
  options                    String  @default("") // выбранные параметры (текст)
  externalPrice              Decimal @db.Decimal(10, 2) // цена покупателю за позицию (только владелец)
  floristItemPrice           Decimal @default(0) @db.Decimal(10, 2) // снимок цены флориста за позицию

  // ── Ручной заказ: позиция БЕЗ каталога ──
  // У такой позиции productId и variantId = NULL, и вывести финансовый тип неоткуда.
  // NULL здесь — обычный случай: тип берётся из Product/ProductVariant, как и раньше.
  // Заполняется только владельцем в форме ручного заказа (блок «Дополнительно»).
  financialTypeSnapshot     FinancialItemType?
  /// Закупочная стоимость вазы или подарка этой позиции, в центах. Имеет смысл только
  /// вместе с financialTypeSnapshot: без каталога VasePurchaseCost привязать не к чему.
  purchaseCostSnapshotCents Int?

  @@index([orderId])
}

// История назначений заказа флористам. Активное состояние заказа — в Order.assignmentStatus.
model OrderAssignment {
  id                   String          @id @default(cuid())
  orderId              String
  order                Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  floristId            String
  florist              Florist         @relation(fields: [floristId], references: [id], onDelete: Cascade)
  state                AssignmentState @default(ASSIGNED)
  priceMode            PriceMode       @default(AUTO)
  floristTotalSnapshot Decimal         @default(0) @db.Decimal(10, 2)
  assignedAt           DateTime        @default(now())
  respondedAt          DateTime?

  @@index([orderId])
  @@index([floristId])
}

// ─────────────────────────────  СООБЩЕНИЯ (тестовые на этапе 1)  ─────────────────────────────

model Message {
  id        String           @id @default(cuid())
  orderId   String
  order     Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  channel   MessageChannel
  direction MessageDirection
  party     MessageParty
  body      String
  createdAt DateTime         @default(now())

  @@index([orderId])
}

/**
 * Единая история коммуникаций по заказу (QUO/OpenPhone): SMS, звонки, voicemail. Привязка к
 * заказу — на уровне КОНКРЕТНОГО события по нормализованному телефону + дате (orderId nullable:
 * непривязанные события живут в разделе «Нераспознанные коммуникации»). Идемпотентность — по
 * (provider, providerEventId). Секреты/сырой webhook целиком НЕ храним (только нужные метаданные).
 */
model OrderCommunication {
  id      String  @id @default(cuid())
  orderId String?
  order   Order?  @relation(fields: [orderId], references: [id], onDelete: SetNull)

  provider               String  @default("QUO")
  providerEventId        String? // QUO webhook event id (EV…) — ключ идемпотентности
  providerResourceId     String? // message/call id (AC…) — для дозагрузки записи/транскрипта
  providerConversationId String? // conversation id (CN…)
  providerUserId         String? // QUO user (US…), кто звонил/ответил/отправил
  providerPhoneNumberId  String? // QUO phone number id магазина (PN…)

  type      CommunicationType
  direction CommunicationDirection
  partyRole CommunicationPartyRole @default(UNKNOWN)
  status    CommunicationStatus

  storePhone              String? // номер магазина, через который прошла коммуникация (E.164)
  externalPhone           String // отображаемый номер собеседника
  externalPhoneNormalized String // E.164 для сопоставления

  messageText     String? // текст SMS
  durationSeconds Int? // длительность звонка
  recordingUrl    String? // ссылка на запись (QUO)
  transcript      String? // транскрипт звонка (Business/Scale)
  summary         String? // краткое содержание звонка (Business/Scale)
  attachmentsJson Json? // MMS/вложения [{url,type}]
  rawMetadata     Json? // компактные доп. поля события (без секретов/сырого payload целиком)

  occurredAt  DateTime // время события в QUO
  deliveredAt DateTime? // подтверждение доставки исходящего
  readAt      DateTime? // глобальное (командное) прочтение входящего/пропущенного
  ignoredAt   DateTime? // «Игнорировать» для нераспознанных (исчезает из активного списка)

  // Исходящие: устойчивый app-level ключ идемпотентности (двойной клик/повтор формы → без дублей).
  sendKey      String? @unique
  sentByUserId String? // кто из сотрудников админки отправил (User.id), для исходящих

  automationJobs AutomationJob[] // авто-SMS job'ы, чьё сообщение записано в эту коммуникацию
  flowRunSteps   AutomationFlowRunStep[] // шаги цепочек, чьё SMS записано в эту коммуникацию

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([provider, providerEventId])
  @@index([orderId, occurredAt])
  @@index([externalPhoneNormalized, occurredAt])
  @@index([providerResourceId])
  @@index([orderId, readAt])
}

// Зарегистрированные Shopify webhook-подписки по Site — чтобы не создавать дубли и
// хранить внешние ID/статус. Одна запись на (siteId, topic).
model ShopifyWebhook {
  id               String   @id @default(cuid())
  siteId           String
  site             Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  topic            String // напр. "ORDERS_CREATE"
  shopifyWebhookId String? // GID подписки в Shopify
  status           String   @default("ACTIVE") // ACTIVE | FAILED | DELETED
  lastError        String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([siteId, topic])
  @@index([siteId])
}

// ─────────────────────────────  WOOCOMMERCE  ─────────────────────────────
//
// Платформенные credentials и настройки WooCommerce — отдельная 1:1 модель к Site.
// Shopify-поля остаются inline в Site и НЕ рефакторятся (Shopify уже на production).
// Все секреты — ТОЛЬКО зашифрованы (AES-256-GCM, тот же lib/crypto/secretBox, что и Shopify).

model WooCommerceConnection {
  id     String @id @default(cuid())
  siteId String @unique
  site   Site   @relation(fields: [siteId], references: [id], onDelete: Cascade)

  // URL нормализуется сервером: только HTTPS, без credentials/query/hash, без trailing slash.
  // @unique — DB-гарантия, что один магазин нельзя подключить дважды (идемпотентность подключения).
  storeUrl   String @unique // "https://example.com"
  apiBaseUrl String // storeUrl + "/wp-json/" + apiVersion — собирается сервером
  apiVersion String @default("wc/v3")

  consumerKeyEncrypted    String
  consumerSecretEncrypted String
  consumerSecretMask      String // "********abcd" — для UI без расшифровки
  // Уникальный webhook secret этого Site (генерируем сами, НЕ равен consumer secret).
  webhookSecretEncrypted  String?

  connStatus      WooConnStatus @default(CONNECTING)
  connectionError String? // безопасный текст (без секретов/PII)

  // ── Airwallex Payment Monitoring (API-опрос статуса платежа; отдельно от разбора meta выше) ──
  airwallexMonitoringEnabled    Boolean   @default(false) // checkbox «Airwallex Payment Monitoring»
  airwallexApiClientIdEncrypted String? // secretBox
  airwallexApiKeyEncrypted      String? // secretBox
  airwallexApiKeyMask           String? // "****abcd" — для UI без расшифровки
  airwallexApiEnv               String    @default("prod") // "prod" | "demo"
  airwallexPendingThresholdMin  Int       @default(30) // порог «долгого pending», минут
  airwallexApiVerifiedAt        DateTime? // включить мониторинг можно только после успешного Verify
  airwallexApiConnStatus        String? // "ok" | "unauthorized" | "error"
  airwallexApiErrorSafe         String? // безопасная ошибка, без секретов

  storeName  String?
  currency   String?
  timezone   String?
  wooVersion String?
  wpVersion  String?

  lastConnectionCheckAt DateTime?
  lastProductSyncAt     DateTime?
  lastOrderSyncAt       DateTime?

  // Конфигурируемый маппинг «внутреннее поле Floremart → Woo meta key». JSON, per-Site.
  // Напр. { "deliveryDate": "_delivery_date", "cardMessage": "card_message" }.
  orderMetaMapping Json?

  // ── Airwallex / Klarna BNPL (см. classifyWooPayment) ── ничего не хардкодим.
  airwallexEnabled                 Boolean  @default(false)
  klarnaPayLaterPendingIsConfirmed Boolean  @default(false)
  airwallexPaymentMethodIds        String[] @default([]) // напр. ["airwallex_klarna", "airwallex_paylater"]
  airwallexMetaKeys                Json? // { "paymentIntentStatus": "_airwallex_payment_status", ... }
  payLaterMaxWaitMinutes           Int      @default(1440) // сколько ждём финального статуса, иначе предупреждение
  unknownBehavior                  String   @default("HOLD") // HOLD | AWAITING_PAYMENT — поведение при UNKNOWN

  // Мониторинг Airwallex подтвердил оплату (PAID) → проставить заказу в Woo `processing`.
  // Единственная запись Floremart в чужие заказы, поэтому под отдельным выключателем.
  pushPaidStatusToWoo Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Зарегистрированные WooCommerce webhook-подписки по Site. Отдельно от ShopifyWebhook:
// у платформ разные external ID/topics/HMAC/жизненный цикл (общий интерфейс — на уровне
// TS-адаптера, хранение раздельное). Одна запись на (siteId, topic).
model WooCommerceWebhook {
  id             String    @id @default(cuid())
  siteId         String
  site           Site      @relation(fields: [siteId], references: [id], onDelete: Cascade)
  topic          String // "order.created" | "product.updated" | ...
  externalId     String? // id вебхука в WooCommerce
  deliveryUrl    String
  status         String    @default("ACTIVE") // ACTIVE | FAILED | DELETED
  lastDeliveryAt DateTime?
  lastError      String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([siteId, topic])
  @@index([siteId])
}

// ─────────────────────────────  ДОСТАВКА (BURQ)  ─────────────────────────────
//
// Черновики Burq создаются автоматически (отложенная outbox-задача), но курьер и платная
// доставка оформляются флористом вручную в кабинете Burq (checkout_url). Секреты Burq — в env.

// Точка забора флориста (pickup). У флориста их несколько; ровно одна помечена isPrimary
// (partial unique index — добавлен в migration.sql, Prisma-схемой не выражается). Основная
// используется для новых заказов; в конкретном заказе её можно переопределить
// (Order.pickupLocationOverrideId). Точки не удаляются, а деактивируются: на них ссылаются
// снимки Delivery.pickupLocationId из истории попыток.
/// Точка магазина на картах Google, у которой клиент оставляет отзыв.
///
/// Точек у магазина несколько (обычно 2–3), и какая достанется заказу — решает ZIP адреса
/// доставки. Именно ZIP, а не город: город в заказах пишут как попало («LA», «Los Angeles»,
/// «Ladera Heights»), а ZIP заполнен всегда и однозначен.
///
/// Не путать с FloristPickupLocation: та про то, ОТКУДА курьер забирает букет, и живёт у
/// флориста. Эта — про то, ГДЕ клиент пишет отзыв, и живёт у магазина.
model GoogleLocation {
  id     String @id @default(cuid())
  siteId String
  site   Site   @relation(fields: [siteId], references: [id], onDelete: Cascade)

  /// Как точка называется в Google — чтобы владелец узнал её в списке.
  name String
  /// Идентификатор точки в Business Profile. Пусто, пока обход не подключён (этап 3):
  /// на первом этапе точка нужна ради ссылки, а читать отзывы ещё нечем.
  googleLocationId String?
  /// Короткая ссылка «оставить отзыв» — её и отправляем клиенту.
  reviewUrl String
  /// Почтовый индекс, где точка стоит на карте. Больше от владельца ничего не нужно: какие
  /// адреса относятся к этой точке, система считает сама по расстоянию (см. locationPick.ts).
  /// Пустой индекс допустим у запасной точки — она достаётся не по географии, а по решению.
  zipCode String?
  /// Запасная точка магазина: достаётся заказу, чей ZIP не нашёлся ни у одной точки.
  /// Такая точка у магазина ровно одна — частичный уникальный индекс в миграции.
  isDefault Boolean @default(false)
  /// Выключенная точка не предлагается заказам и не обходится сканером. Не удаляем:
  /// на неё уже могут ссылаться отправленные ссылки и подтверждённые отзывы.
  isActive Boolean @default(true)

  /// Состояние последнего обхода (этап 3). Точка, молчащая дольше суток, — это сигнал.
  lastScanAt        DateTime?
  lastScanErrorSafe String?

  reviewRequests OrderReviewRequest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([siteId])
}

/// Запрос отзыва по заказу: одна строка на заказ, создаётся пометкой владельца «Попросить
/// отзыв». Дальше её ведёт колл-центр.
///
/// Очередь оператора строится по `nextActionAt`, а НЕ по статусу: «перезвонить завтра» иначе
/// негде хранить, и вкладка «сегодня» не собралась бы. Пустое поле означает «ждём клиента, сами
/// ничего не делаем».
model OrderReviewRequest {
  id      String @id @default(cuid())
  orderId String @unique
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  /// Точка, на которую просим отзыв. Снимок решения: подставляется по ZIP при создании, но
  /// оператор может сменить, а разметку ZIP владелец может позже поправить — запрос должен
  /// помнить, куда мы отправляли клиента на самом деле.
  locationId String?
  location   GoogleLocation? @relation(fields: [locationId], references: [id], onDelete: SetNull)
  /// Ссылка на момент отправки. Точку могут удалить, а знать, что получил клиент, надо всегда.
  reviewUrlSnapshot String?

  status       ReviewRequestStatus @default(NEW)
  callAttempts Int                 @default(0)
  /// Когда оператору вернуться к этому запросу. NULL — ждём клиента.
  nextActionAt DateTime?

  linkSentAt  DateTime?
  linkChannel ReviewLinkChannel?

  promisedAt DateTime?
  remindedAt DateTime?

  confirmedAt       DateTime?
  confirmedVia      ReviewConfirmVia?
  confirmedByUserId String?
  confirmedBy       User?             @relation("ReviewConfirmedBy", fields: [confirmedByUserId], references: [id], onDelete: SetNull)

  closedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  events ReviewRequestEvent[]

  @@index([status, nextActionAt])
  @@index([locationId])
}

/// Журнал запроса — только добавление, как книга операций в финансах.
model ReviewRequestEvent {
  id        String             @id @default(cuid())
  requestId String
  request   OrderReviewRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  kind ReviewEventKind
  /// Кто сделал. Пусто у автоматики (напоминание, переход по сроку).
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  /// Безопасная деталь: код канала, причина отказа отправки. Без PII сверх нужного.
  detailSafe String?

  createdAt DateTime @default(now())

  @@index([requestId, createdAt])
}

/// Настройки модуля отзывов на магазин. Строки может не быть — это «работаем по умолчанию»,
/// а не поломка: тот же принцип, что у настроек печати.
model SiteReviewSettings {
  siteId String @id
  site   Site   @relation(fields: [siteId], references: [id], onDelete: Cascade)

  /// Текст SMS со ссылкой. {{review_url}} и остальные переменные заказа доступны как обычно.
  askSmsTemplate     String?
  /// Brevo Template ID для письма со ссылкой, когда SMS не смогла уйти.
  askBrevoTemplateId Int?

  reminderSmsTemplate     String?
  reminderBrevoTemplateId Int?

  /// Сколько ждать обещанного отзыва, прежде чем напомнить.
  promiseWaitDays Int @default(14)
  /// Сколько раз звонить, прежде чем отправить ссылку самим.
  maxCallAttempts Int @default(2)
  /// Через сколько дней перезванивать после неудачного звонка.
  callRetryDays   Int @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model FloristPickupLocation {
  id                  String   @id @default(cuid())
  floristId           String
  florist             Florist  @relation(fields: [floristId], references: [id], onDelete: Cascade)
  isPrimary           Boolean  @default(false)
  locationName        String
  contactName         String
  contactPhone        String // E.164
  addressLine         String
  apartmentOrSuite    String?
  city                String
  state               String // 2-буквенный US-код
  zip                 String
  courierInstructions String?
  isActive            Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  orderOverrides Order[] @relation("OrderPickupOverride")

  @@index([floristId])
}

// Планирование черновика: версия расписания для anti-stale отложенных задач. 1:1 Order.
model DeliveryIntent {
  id                   String               @id @default(cuid())
  orderId              String               @unique
  order                Order                @relation(fields: [orderId], references: [id], onDelete: Cascade)
  scheduleVersion      Int                  @default(0) // ++ при каждом перепланировании
  scheduledAvailableAt DateTime? // когда задача должна выполниться (UTC)
  intentStatus         DeliveryIntentStatus @default(SCHEDULED)
  lastSkipReason       String? // FLORIST_NOT_ASSIGNED | PICKUP_NOT_CONFIGURED | PICKUP_INACTIVE | PICKUP_INVALID | ...
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
}

// Одна попытка доставки (attempt). Несколько исторических на Order; актуальна ровно одна
// (partial unique index isCurrentAttempt=true — добавлен в migration.sql, Prisma-схемой не выражается).
model Delivery {
  id                String           @id @default(cuid())
  orderId           String
  order             Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider          DeliveryProvider @default(BURQ)
  floristId         String? // флорист, чей pickup использован
  florist           Florist?         @relation("DeliveryFlorist", fields: [floristId], references: [id])
  pickupLocationId  String? // снимок id использованной точки забора
  expectedFloristId String? // ожидаемый флорист на момент старта POST (защита от гонки)
  attemptNumber     Int              @default(1)
  isCurrentAttempt  Boolean          @default(true)

  externalDeliveryId String? // Burq order id
  externalOrderRef   String? // наш external_order_ref, переданный в Burq
  checkoutUrl        String? // ссылка кабинета Burq (чувствительная — доступ флориста)
  isDraft            Boolean @default(true)

  status            DeliveryProviderStatus @default(DRAFT_PENDING)
  rawProviderStatus String?
  providerEventAt   DateTime? // время последнего применённого provider-события (anti-rollback)

  idempotencyKey           String? // x-idempotency-key внешнего POST
  quoteAmount              Decimal?  @db.Decimal(10, 2)
  currency                 String?
  // Фактическая стоимость доставки Uber из Burq (Path A: после dispatch, из latest_delivery).
  finalCost                Decimal?  @db.Decimal(10, 2) // total_amount_due (или fee) в долларах
  finalCostUpdatedAt       DateTime?
  quoteId                  String? // latest_delivery.quote_id
  providerName             String? // latest_delivery.provider (напр. "uber")
  providerExternalId       String? // latest_delivery.provider_id (стабильный id провайдера)
  costSource               String? // "BURQ_FINAL" (Path A) | (в будущем "UBER_QUOTE")
  trackingUrl              String?
  courierName              String?
  courierPhone             String?
  estimatedPickupAt        DateTime?
  estimatedDeliveryAt      DateTime?
  pickedUpAt               DateTime?
  deliveredAt              DateTime?
  cancelledAt              DateTime?
  cancellationReason       String? // FLORIST_REASSIGNED | MANUAL_ADMIN | ...
  failureCode              String?
  failureMessageSafe       String?
  proofOfDeliveryUrl       String? // @deprecated — не используется; оставлено для обратной совместимости
  // Proof of Delivery (Path A, первая версия — храним Burq URL как есть, без копирования в наше хранилище).
  proofOfDeliveryUrls      Json? // массив URL фото подтверждения доставки (proof_of_delivery_image_urls)
  signatureImageUrl        String? // signature_image_url (если когда-либо запрошен)
  proofOfDeliveryFetchedAt DateTime?

  // ── Проверка наличия курьеров на маршрут (сразу после создания черновика) ──
  // NULL в couriersAvailable = не проверяли (проверка не запускалась или упала).
  // 0 = котировок не вернулось вовсе, то есть маршрут никто не берётся везти — это и есть
  // сигнал, ради которого проверка существует. Котировки Burq живут минуты, поэтому число
  // всегда читается вместе с couriersCheckedAt: без времени оно ничего не значит.
  couriersCheckedAt DateTime?
  couriersAvailable Int?

  // Переназначение/суперседанс попыток (историю не переписываем).
  supersedesDeliveryId   String?
  supersededByDeliveryId String?

  resolutionSource DeliveryEventSource?
  resolvedByUserId String?

  lastWebhookAt     DateTime?
  lastStatusCheckAt DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  statusEvents DeliveryStatusEvent[]

  @@index([orderId])
  @@index([externalDeliveryId])
}

// История статусов доставки (без полного payload и PII).
model DeliveryStatusEvent {
  id               String                  @id @default(cuid())
  deliveryId       String
  delivery         Delivery                @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  providerEventId  String? // id события Burq (для дедупа)
  rawStatus        String?
  normalizedStatus DeliveryProviderStatus
  source           DeliveryEventSource
  userId           String? // сотрудник (для MANUAL_ADMIN)
  previousStatus   DeliveryProviderStatus?
  newStatus        DeliveryProviderStatus?
  safeReason       String?
  occurredAt       DateTime? // provider event time
  receivedAt       DateTime                @default(now())
  createdAt        DateTime                @default(now())

  @@unique([deliveryId, providerEventId]) // дедуп webhook-события по (delivery, providerEventId)
  @@index([deliveryId])
}

// ─────────────────────────────  OUTBOX / ФОНОВЫЕ СОБЫТИЯ  ─────────────────────────────
//
// Персистентный transactional outbox: доменные события сохраняются ДО обработки, чтобы
// не терялись при рестарте процесса (в отличие от in-process шины). Отдельный worker
// (scripts/outbox-worker.ts) поллит эту таблицу с lock/lease, ретраями и dead-letter.
// Модели ADDITIVE — существующие таблицы не затрагиваются. См. docs/OUTBOX_AND_WORKER.md.

enum OutboxStatus {
  PENDING // ждёт обработки
  PROCESSING // взято worker'ом (lease), в работе
  PROCESSED // успешно обработано
  FAILED // временный сбой, будет повтор (attempts < maxAttempts)
  DEAD_LETTER // исчерпаны попытки — требует ручного вмешательства
}

model OutboxEvent {
  id             String       @id @default(cuid())
  eventType      String // напр. "order.delivery.completed"
  aggregateType  String // напр. "order"
  aggregateId    String // напр. Order.id
  payload        Json // тонкий payload события (без PII сверх необходимого)
  idempotencyKey String       @unique // дедуп публикации: одно событие = одна запись
  status         OutboxStatus @default(PENDING)
  attempts       Int          @default(0)
  maxAttempts    Int          @default(8)
  availableAt    DateTime     @default(now()) // не брать раньше этого времени (backoff)
  lockedAt       DateTime? // когда взято в обработку (для восстановления зависших)
  lockedBy       String? // идентификатор worker'а, держащего lease
  processedAt    DateTime?
  lastError      String? // последняя БЕЗОПАСНАЯ ошибка (без PII/секретов)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  // Поллинг worker'а: выбираем доступные PENDING/FAILED по availableAt.
  @@index([status, availableAt])
  // Восстановление зависших PROCESSING по lockedAt.
  @@index([status, lockedAt])
  @@index([aggregateType, aggregateId])
}

// Универсальный guard идемпотентности провайдер-операций: гарантирует, что конкретное
// побочное действие (отправка SMS/Telegram, Shopify/Woo fulfillment, создание Burq-доставки)
// выполняется РОВНО один раз, даже при повторной доставке события. Проверяется до действия.
model ProcessedOperation {
  id           String   @id @default(cuid())
  operationKey String   @unique // напр. "order.delivery.completed:<orderId>:sms"
  kind         String // напр. "sms.send", "telegram.send", "shopify.fulfillment"
  externalId   String? // id результата у провайдера (напр. message id), если есть
  createdAt    DateTime @default(now())

  @@index([kind])
}

/**
 * Отправленное внутреннее Telegram-уведомление. Хранит message_id, чтобы обновлять
 * существующее сообщение (editMessage) вместо создания дубля.
 * `dedupeKey` включает роль/аудиторию, поэтому у одного заказа независимо живут основное
 * сообщение флористам ("order:{id}:florist") и владельцу ("order:{id}:owner"), а срочные
 * уведомления владельцу получают собственные ключи и НЕ затирают основное.
 * chatId/messageId — строки: id супергрупп у Telegram — большие отрицательные числа, и хранение
 * строкой исключает потерю точности; над этими значениями арифметика не нужна.
 */
model TelegramMessage {
  id        String           @id @default(cuid())
  dedupeKey String           @unique
  audience  TelegramAudience
  chatId    String
  messageId String
  orderId   String?
  order     Order?           @relation(fields: [orderId], references: [id], onDelete: SetNull)
  // Каким ботом отправлено — без этого не понять, чьим токеном редактировать.
  botId     String?
  bot       TelegramBot?     @relation(fields: [botId], references: [id], onDelete: SetNull)
  eventType String
  lastText  String? // последний отправленный текст/подпись — не редактируем, если не изменился
  // Сообщение с фото и текстовое правятся разными методами Telegram (editMessageCaption vs
  // editMessageText) и не конвертируются. Храним тип, чтобы при передаче заказа выбрать верный.
  isPhoto   Boolean          @default(false)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@index([orderId])
}

/**
 * Бот Telegram. У каждого флориста СВОЙ бот и свой личный чат: бот не может редактировать
 * сообщение, отправленное другим ботом, поэтому «одно сообщение на заказ» существует в
 * пределах одного бота, а не всей системы.
 * Токен — только зашифрованным (secretBox). Включение возможно лишь после успешной проверки:
 * любое изменение токена или чата сбрасывает verifiedAt и enabled.
 */
model TelegramBot {
  id             String             @id @default(cuid())
  label          String
  purpose        TelegramBotPurpose
  tokenEncrypted String?
  botUsername    String?
  chatId         String?
  floristId      String?            @unique // заполнено только у purpose = FLORIST
  florist        Florist?           @relation(fields: [floristId], references: [id], onDelete: Cascade)
  enabled        Boolean            @default(false)
  verifiedAt     DateTime?
  lastErrorSafe  String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  messages TelegramMessage[]

  @@index([purpose])
}

/**
 * Настройки внутренних Telegram-уведомлений (singleton, id="singleton").
 * Заменяют конфигурацию через .env: владелец задаёт всё из дашборда.
 * Секрет хранится ТОЛЬКО зашифрованным (AES-256-GCM, lib/crypto/secretBox) — в UI токен
 * обратно никогда не отдаётся, показывается лишь факт «настроен».
 * `enabled` можно включить лишь после успешной проверки: verifiedAt заполняется при удачном
 * getMe + тестовых сообщениях. Любое изменение токена или чата сбрасывает verifiedAt и enabled,
 * иначе можно было бы оставить включённым заведомо нерабочий конфиг.
 */
model TelegramSettings {
  id                String    @id @default("singleton")
  botTokenEncrypted String?
  ownerChatId       String?
  floristsChatId    String?
  enabled           Boolean   @default(false)
  verifiedAt        DateTime?
  botUsername       String? // из getMe — показываем владельцу, что подключён нужный бот
  lastErrorSafe     String? // безопасная причина последней неудачи, без секретов
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

/**
 * Текущее состояние Airwallex-платежа заказа (1:1). Одна активная запись на заказ (MVP):
 * при смене intent id старое уходит в AirwallexCheck, запись сбрасывается на новый intent.
 * Режим наблюдения: business status заказа НЕ меняется.
 */
model AirwallexPayment {
  id                    String                     @id @default(cuid())
  orderId               String                     @unique
  order                 Order                      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  siteId                String
  paymentIntentId       String?
  paymentMethod         String?
  lastRawStatus         String?
  lastAttemptId         String?
  lastAttemptStatus     String?
  normalizedStatus      AirwallexNormalizedStatus?
  firstSeenAt           DateTime                   @default(now())
  firstPendingAt        DateTime?
  lastCheckedAt         DateTime?
  nextCheckAt           DateTime?
  stopCheckingAt        DateTime?
  pendingAlertSentAt    DateTime?
  failedAlertAttemptId  String?
  notFoundCount         Int                        @default(0)
  consecutiveErrorCount Int                        @default(0)
  monitoringActive      Boolean                    @default(true)
  safeError             String?
  createdAt             DateTime                   @default(now())
  updatedAt             DateTime                   @updatedAt

  @@index([siteId, monitoringActive, nextCheckAt])
}

/**
 * Компактный журнал сверок Airwallex (без полного raw payload).
 */
model AirwallexCheck {
  id               String                     @id @default(cuid())
  orderId          String
  order            Order                      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  siteId           String
  paymentIntentId  String?
  attemptId        String?
  rawStatus        String?
  attemptStatus    String?
  normalizedStatus AirwallexNormalizedStatus?
  outcome          String
  safeError        String?
  checkedAt        DateTime                   @default(now())

  @@index([orderId, checkedAt])
  @@index([siteId, checkedAt])
}

// ─────────────────────────────  BURQ SETTINGS  ─────────────────────────────
//
// Глобальные настройки интеграции Burq (единственная строка, id="singleton").
// Секреты (API Key, Webhook Secret) хранятся ТОЛЬКО в зашифрованном виде (AES-256-GCM,
// см. lib/crypto/secretBox); в UI отдаётся лишь маска. Открытый текст нигде не логируется.
//
// enabled — интеграция настроена/включена (приём webhook, connection check).
// draftCreationEnabled — ОТДЕЛЬНЫЙ гейт авто-создания доставок; ВЫКЛ до подтверждения sandbox.
enum BurqEnvironment {
  SANDBOX
  PRODUCTION
}

model BurqSettings {
  id                     String          @id @default("singleton")
  environment            BurqEnvironment @default(SANDBOX)
  apiKeyEncrypted        String?
  apiKeyMask             String? // "********abcd" — для UI без расшифровки
  webhookSecretEncrypted String?
  webhookSecretMask      String?
  apiBaseUrl             String? // advanced override; по умолчанию официальный URL
  enabled                Boolean         @default(false)
  draftCreationEnabled   Boolean         @default(false) // гейт авто-создания draft (OFF до sandbox)
  lastConnectionCheckAt  DateTime?
  connectionStatus       String? // "ok" | "unauthorized" | "error" | "saved_not_checked"
  connectionErrorSafe    String? // безопасное сообщение, без секретов
  // Глобальные order-level dimensions для Burq (обязательны в Create Order V2). Настраиваемые.
  packageLength          Float?
  packageWidth           Float?
  packageHeight          Float?
  packageWeight          Float?
  dimensionUnit          String          @default("in") // "in" | "cm"
  weightUnit             String          @default("lb") // "lb" | "kg" | "g"
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt
}

// Аудит действий с настройками Burq. БЕЗ секретов — только кто/что/когда/окружение.
model BurqSettingsAudit {
  id          String          @id @default(cuid())
  userId      String
  action      String // "save_credentials" | "toggle_enabled" | "change_environment" | "connection_check" | "toggle_draft_creation"
  environment BurqEnvironment
  detailSafe  String? // безопасная деталь без секретов (напр. "enabled=true")
  createdAt   DateTime        @default(now())

  @@index([createdAt])
}

/**
 * Аудит ручного редактирования полей заказа сотрудниками (owner/call-center/florist).
 * Пишется в ТОЙ ЖЕ транзакции, что и обновление заказа (см. updateOrderBlock). `changed`
 * содержит ТОЛЬКО before/after изменившихся полей блока — без паролей, токенов, секретов
 * и полного payload. Отдельного UI просмотра пока нет (только запись).
 */
model OrderAudit {
  id        String   @id @default(cuid())
  orderId   String
  userId    String
  role      Role
  block     String // contacts | sender | status | delivery | cardNote | charges
  changed   Json // { field: { from, to } } — только изменённые поля
  createdAt DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([orderId, createdAt])
  @@index([userId, createdAt])
}

/**
 * Зашифрованные секреты интеграций (глобально, не per-Site). Одна строка = один секрет.
 * Значение — только в зашифрованном виде (AES-256-GCM, lib/crypto/secretBox). В UI отдаётся
 * ТОЛЬКО `maskedSuffix` (маска), полное значение из браузера недоступно. Сейчас используется для
 * QUO webhook signing secrets (provider="QUO", kind="webhook_signing_secret"); модель обобщаемая.
 */
model IntegrationSecret {
  id             String   @id @default(cuid())
  provider       String // "QUO" | "BREVO"
  kind           String // "webhook_signing_secret" | "api_key"
  encryptedValue String // AES-256-GCM payload (никогда не отдаётся в браузер)
  maskedSuffix   String // "********abcd" — только для UI
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  /**
   * Магазин, которому принадлежит секрет. NULL = секрет уровня аккаунта (подпись вебхуков QUO
   * общая на всю систему). Ключ Brevo — ВСЕГДА со своим siteId: у магазинов разные аккаунты
   * Brevo, и общего ключа больше нет. Одно и то же значение у разных магазинов допустимо —
   * уникальности по значению здесь нет и быть не должно.
   */
  siteId String?
  site   Site?   @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([provider, kind, active])
  @@index([provider, kind, siteId, active])
}

/**
 * Статус последней проверки подключения к Brevo (singleton, одна строка). Сам ключ здесь НЕ
 * хранится — он лежит в IntegrationSecret (provider="BREVO", kind="api_key"); эта таблица —
 * только результат «Проверить подключение» (GET /v3/account), чтобы бейдж в UI переживал refresh.
 */
model BrevoAccountStatus {
  id           String    @id @default(cuid())
  connStatus   String? // "CONNECTED" | "ERROR"
  verifiedAt   DateTime?
  accountEmail String? // email Brevo-аккаунта из /v3/account — только для UI-индикации
  errorSafe    String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  /**
   * Проверка подключения относится к КЛЮЧУ, а ключ теперь у каждого магазина свой — значит и
   * результат проверки свой. Одна строка на магазин.
   */
  siteId String @unique
  site   Site   @relation(fields: [siteId], references: [id], onDelete: Cascade)
}

// ─────────────────────────────  SMS-МАРКЕТИНГ  ─────────────────────────────
//
// Движок правил авто-SMS: SmsAutomation (правило) + SmsAutomationJob (задача + история).
// Отложенное исполнение — через существующий durable outbox (availableAt), отдельной очереди НЕТ.
// Реальная отправка — через sendOrderSms (номер Site, запись OrderCommunication). Всё ADDITIVE.
// triggerType — String + централизованный app-registry (src/modules/sms/triggers.ts): новый
// триггер добавляется без Prisma-миграции; неизвестное значение показывается как «Unsupported»
// и не запускается. Все правила после deploy выключены (active=false), seed-правил нет.

enum SmsAudience {
  CUSTOMER
  RECIPIENT
  BOTH
}

// Адресат конкретного job'а — строго один из двух. BOTH разворачивается в per-recipient job'ы,
// поэтому записать BOTH в job by design нельзя (отдельный enum, а не SmsAudience).
enum SmsRecipientType {
  CUSTOMER
  RECIPIENT
}

enum SmsDelayUnit {
  IMMEDIATE
  MINUTE
  HOUR
  DAY
  WEEK
  MONTH
}

enum SmsJobStatus {
  SCHEDULED
  PROCESSING
  SENT
  SKIPPED
  FAILED
  CANCELLED
}

model Automation {
  id     String  @id @default(cuid())
  name   String
  active Boolean @default(false) // после deploy все правила выключены

  // Каналы доставки — независимые флаги (расширяется без изменения модели через
  // ChannelSender-реестр, src/modules/messaging/channels). Значения по умолчанию НЕ случайны:
  // это ровно то поведение, что было до появления Email (SMS вкл, Email и fallback выкл).
  smsEnabled           Boolean @default(true)
  emailEnabled         Boolean @default(false)
  /**
   * «Email, если SMS недоступно» — имеет смысл только при smsEnabled=true (проверяется при сохранении).
   */
  emailFallbackEnabled Boolean @default(false)
  /**
   * Override Brevo Template ID именно ЭТОГО правила (Stage 2.1). null (по умолчанию) → берём
   * общий шаблон магазина под это triggerType (SiteEmailTemplate). Заполнен → это правило шлёт
   * СВОИМ шаблоном, даже если у магазина/других правил на то же событие настроен другой —
   * так два правила на одно событие (сегменты, разные тексты) не заставляют держать два
   * SiteEmailTemplate под одну и ту же пару siteId+triggerType (там unique-ограничение).
   */
  brevoTemplateId      Int?

  triggerType    String // валидируется app-registry; строкой — для расширяемости без миграции
  audience       SmsAudience
  delayAmount    Int          @default(0)
  delayUnit      SmsDelayUnit @default(IMMEDIATE)
  template       String // текст шаблона inline (отдельная Template-сущность — фаза 2)
  conditionsJson Json? // расширяемые условия (нормализованные AutomationCondition — фаза 2)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  deletedAt      DateTime? // soft-delete при наличии истории

  jobs  AutomationJob[]
  // Магазины правила (many-to-many): одно правило — один шаблон на несколько Site.
  sites AutomationSite[]

  @@index([triggerType, active])
}

// Связка «правило ↔ магазин». Единственный источник правды о магазинах автоматизации
// (Automation.siteId удалён миграцией 20260722120000_automation_multi_site).
model AutomationSite {
  automationId String
  siteId       String

  automation Automation @relation(fields: [automationId], references: [id], onDelete: Cascade)
  site       Site       @relation(fields: [siteId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@id([automationId, siteId])
  @@index([siteId])
}

model AutomationJob {
  id           String     @id @default(cuid())
  automationId String
  // Restrict: правило с историей нельзя удалить физически (только soft-delete) — job'ы сохраняются.
  automation   Automation @relation(fields: [automationId], references: [id], onDelete: Restrict)
  orderId      String
  order        Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)

  recipientType   SmsRecipientType // только CUSTOMER | RECIPIENT
  // Stage 2: канал ЭТОГО job'а (routing в handlers.ts: deps.channels[job.channel], а не
  // automation.channel — одно правило может породить и SMS-job, и EMAIL-job одновременно).
  channel         String           @default("SMS") // "SMS" | "EMAIL"
  // Для SMS обязателен, для EMAIL — null. Для EMAIL адресат — emailNormalized.
  phoneNormalized String? // E.164 адресата (для дедупа BOTH и истории)
  emailNormalized String? // нормализованный email адресата (только для channel="EMAIL", всегда CUSTOMER)
  // Дублирует часть idempotencyKey отдельной колонкой, чтобы SEND-обработчик мог создать
  // fallback-EMAIL-job (при финальном провале SMS), не разбирая строку idempotencyKey.
  occurrenceKey   String?
  scheduledAt     DateTime // когда worker должен отправить (delay применён)
  status          SmsJobStatus     @default(SCHEDULED)

  renderedTextSnapshot String? // фиксируется в момент фактической отправки (рендер по свежим данным)
  idempotencyKey       String              @unique // automationId:orderId:recipientType:triggerOccurrence:channel
  communicationId      String? // ссылка на созданный OrderCommunication (если отправлено)
  communication        OrderCommunication? @relation(fields: [communicationId], references: [id], onDelete: SetNull)

  sentAt            DateTime?
  skippedAt         DateTime?
  failedAt          DateTime?
  lastErrorSafe     String? // без PII/секретов
  providerMessageId String? // id сообщения у провайдера (для SMS — QUO)
  attempts          Int       @default(0)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  executionLogs AutomationExecutionLog[]

  @@index([status, scheduledAt])
  @@index([automationId, status])
  @@index([orderId])
  @@index([communicationId])
}

// Глобальный «рубильник» автоматизаций (singleton, id="singleton"). При disableAll=true новые
// job'ы не создаются и не отправляются. Строка создаётся лениво при первом переключении (без seed).
model AutomationSettings {
  id              String   @id @default("singleton")
  disableAll      Boolean  @default(false)
  updatedByUserId String?
  updatedAt       DateTime @updatedAt
}

// Журнал выполнения — только для РЕАЛЬНО созданных Job. Пошаговая трассировка (scheduled →
// picked → rendered → provider_accepted → sent/skipped/failed) для быстрой диагностики.
// Без секретов/полного provider payload (только detailSafe).
model AutomationExecutionLog {
  id           String        @id @default(cuid())
  jobId        String
  job          AutomationJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  automationId String
  orderId      String?
  stage        String // scheduled | picked | rendered | provider_accepted | sent | skipped | failed
  detailSafe   String? // безопасная деталь (причина skip, safe error, provider message id) — без PII/секретов
  createdAt    DateTime      @default(now())

  @@index([jobId, createdAt])
  @@index([automationId, createdAt])
}

// ─────────────────────────  AUTOMATION FLOWS (цепочки)  ─────────────────────────
//
// Цепочка = линейный список шагов (WAIT / EMAIL / SMS), запускаемый тем же trigger-событием,
// что и одиночные правила (Automation). Одиночные правила НЕ трогаются: это отдельные модели,
// отдельный outbox-eventType и отдельная ветка в trigger-обработчике.
//
// Отложенность и повторы — существующий durable outbox (availableAt/backoff/dead-letter);
// второй worker и вторая очередь НЕ создаются.
//
// Идемпотентность держится на трёх уровнях: unique(flowId, orderId) — один run на заказ;
// unique(runId, stepId) — один шаг run'а; статус шага (не SCHEDULED → выходим) — повторная
// доставка того же outbox-события не отправляет второй раз.

enum FlowStepType {
  WAIT
  EMAIL
  SMS
}

enum FlowRunStatus {
  ACTIVE // ждёт выполнения следующего шага
  COMPLETED // шаги закончились
  CANCELLED // остановлен (цепочка выключена/удалена, магазин отвязан, заказ отменён)
}

model AutomationFlow {
  id     String  @id @default(cuid())
  name   String
  active Boolean @default(false) // как и одиночные правила — создаётся ВЫКЛЮЧЕННОЙ

  triggerType String // тот же app-registry, что у Automation (src/modules/automations/triggers.ts)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime? // soft-delete: цепочку с историей физически не удаляем

  steps AutomationFlowStep[]
  sites AutomationFlowSite[]
  runs  AutomationFlowRun[]

  @@index([triggerType, active])
}

// Магазины цепочки (M:N) — тот же приём, что AutomationSite: единственный источник правды.
model AutomationFlowSite {
  flowId String
  siteId String

  flow AutomationFlow @relation(fields: [flowId], references: [id], onDelete: Cascade)
  site Site           @relation(fields: [siteId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@id([flowId, siteId])
  @@index([siteId])
}

model AutomationFlowStep {
  id       String         @id @default(cuid())
  flowId   String
  flow     AutomationFlow @relation(fields: [flowId], references: [id], onDelete: Cascade)
  position Int // 1..N — порядок в вертикальном редакторе
  type     FlowStepType

  // WAIT: задержка перед следующим шагом. Единица — общий SmsDelayUnit (UI: минуты/часы/дни).
  waitAmount Int?
  waitUnit   SmsDelayUnit?

  // EMAIL: Brevo Template ID именно этого шага (у цепочек общего шаблона магазина нет —
  // маркетинговое письмо всегда своё, поэтому поле обязательно на уровне валидации).
  brevoTemplateId Int?

  // SMS: inline-текст с теми же переменными {{...}}, что у одиночных правил.
  template String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  // Шаг с историей не удаляем физически: run'ы ссылаются на него (Restrict). Запланированные
  // шаги удалённого шага при выполнении получают SKIPPED и цепочка идёт дальше.
  deletedAt DateTime?

  runSteps AutomationFlowRunStep[]

  @@unique([flowId, position])
  @@index([flowId, position])
}

model AutomationFlowRun {
  id     String         @id @default(cuid())
  flowId String
  // Restrict: цепочку с историей нельзя удалить физически (только soft-delete).
  flow   AutomationFlow @relation(fields: [flowId], references: [id], onDelete: Restrict)

  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  siteId  String
  site    Site   @relation(fields: [siteId], references: [id], onDelete: Cascade)

  status        FlowRunStatus @default(ACTIVE)
  currentStepId String? // шаг, который выполняется/ожидает выполнения
  nextRunAt     DateTime? // время выполнения следующего шага (null — run завершён)

  startedAt       DateTime  @default(now())
  finishedAt      DateTime?
  cancelledReason String? // flow_disabled | flow_deleted | site_unlinked | order_cancelled | no_steps

  steps AutomationFlowRunStep[]

  // Один run на пару (цепочка, заказ) НАВСЕГДА. Так повторный факт триггера (в т.ч. из другого
  // источника — курьер/платформа для «доставлен») не создаёт вторую цепочку по тому же заказу.
  @@unique([flowId, orderId])
  @@index([status, nextRunAt])
  @@index([orderId])
  @@index([siteId, status])
}

model AutomationFlowRunStep {
  id     String             @id @default(cuid())
  runId  String
  run    AutomationFlowRun  @relation(fields: [runId], references: [id], onDelete: Cascade)
  stepId String
  // Restrict: пока есть история выполнения, шаг живёт (удаление шага — soft-delete).
  step   AutomationFlowStep @relation(fields: [stepId], references: [id], onDelete: Restrict)

  // Снимки на момент планирования: история остаётся читаемой, даже если шаг изменили/удалили.
  position Int
  type     FlowStepType

  status      SmsJobStatus @default(SCHEDULED) // SCHEDULED|PROCESSING|SENT|SKIPPED|FAILED|CANCELLED
  scheduledAt DateTime // когда worker должен выполнить шаг
  channel     String? // "SMS" | "EMAIL"; у WAIT — null

  phoneNormalized String? // адресат SMS (E.164)
  emailNormalized String? // адресат EMAIL (нормализованный)

  renderedTextSnapshot String? // текст SMS в момент фактической отправки
  communicationId      String?
  communication        OrderCommunication? @relation(fields: [communicationId], references: [id], onDelete: SetNull)
  providerMessageId    String?

  attempts      Int     @default(0)
  lastErrorSafe String? // без PII/секретов

  sentAt    DateTime?
  skippedAt DateTime?
  failedAt  DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  // ЯДРО ИДЕМПОТЕНТНОСТИ: один шаг цепочки в рамках одного run — ровно одна строка.
  @@unique([runId, stepId])
  @@index([runId, position])
  @@index([status, scheduledAt])
  @@index([communicationId])
}

// ─────────────────────────────  EMAIL (BREVO)  ─────────────────────────────

/**
 * Email-настройки ОДНОГО магазина. Отдельная модель (а не поля на Site) по образцу
 * WooCommerceConnection: набор полей растёт, и держать его рядом с Site неудобно.
 * Секретов здесь нет: API-ключ Brevo — общий на аккаунт и живёт только в переменных
 * окружения. Здесь лежит лишь то, чем магазины отличаются друг от друга: отправитель,
 * reply-to и состояние проверки. Всё выключено по умолчанию (enabled = false), поэтому
 * появление модели ничего не рассылает.
 */
model SiteEmailSettings {
  id     String @id @default(cuid())
  siteId String @unique
  site   Site   @relation(fields: [siteId], references: [id], onDelete: Cascade)

  enabled       Boolean @default(false) // главный выключатель Email для магазина
  senderEmail   String? // напр. orders@theflow.la — домен должен быть подтверждён в Brevo
  senderName    String? // «The Flow» — видимое имя отправителя
  replyTo       String? // куда попадут ответы клиентов (может отличаться от отправителя)
  /**
   * Числовой sender id в Brevo. Необязателен: Brevo принимает и пару name+email.
   */
  brevoSenderId String?

  /**
   * Отметка владельца, что домен отправителя подтверждён в Brevo через DNS.
   */
  domainVerifiedAt DateTime?

  // Результат последнего тестового письма — как у QUO/Airwallex: статус + безопасная ошибка.
  lastTestAt     DateTime?
  lastTestStatus String? // ok | error
  lastErrorSafe  String? // без ключей и адресов получателя

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/**
 * Brevo Template ID для пары «магазин + событие». HTML-шаблоны живут в Brevo (свой логотип,
 * цвета и footer у каждого магазина) — здесь только идентификатор.
 * triggerType хранится строкой и валидируется реестром триггеров (как в Automation), поэтому
 * новое событие не требует миграции.
 */
model SiteEmailTemplate {
  id     String @id @default(cuid())
  siteId String
  site   Site   @relation(fields: [siteId], references: [id], onDelete: Cascade)

  triggerType     String // ORDER_CREATED | ORDER_DELIVERED | …
  brevoTemplateId Int // id шаблона в Brevo

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([siteId, triggerType])
  @@index([siteId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Расходы владельца («Мои расходы»). Ежедневный журнал расходов бизнеса — НЕ
// бухгалтерия: ни проводок, ни счетов, ни валютных курсов.
// ─────────────────────────────────────────────────────────────────────────────

/// Категория расхода — верхний уровень месячной сводки.
model OwnerExpenseCategory {
  id         String    @id @default(cuid())
  name       String    @unique
  /// Встроенную категорию нельзя убрать из списка: она входит в стартовый набор.
  isBuiltin  Boolean   @default(false)
  sortOrder  Int       @default(100)
  archivedAt DateTime?
  createdAt  DateTime  @default(now())

  subcategories OwnerExpenseSubcategory[]
  expenses      OwnerExpense[]

  @@index([archivedAt, sortOrder])
}

/// Подкатегория — второй уровень внутри категории («Подписки» → «OpenAI»). В отличие от
/// свободного поля `title`, переиспользуется и суммируется: «OpenAI» и «Open AI», набранные
/// руками, были бы разными строками, а подкатегория одна.
model OwnerExpenseSubcategory {
  id         String               @id @default(cuid())
  categoryId String
  category   OwnerExpenseCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  name       String
  sortOrder  Int                  @default(100)
  archivedAt DateTime?
  createdAt  DateTime             @default(now())

  expenses OwnerExpense[]

  @@unique([categoryId, name])
  @@index([categoryId, archivedAt, sortOrder])
}

model OwnerExpense {
  id         String               @id @default(cuid())
  categoryId String
  category   OwnerExpenseCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  /// Необязательный второй уровень. NULL — расход отнесён прямо к категории.
  subcategoryId String?
  subcategory   OwnerExpenseSubcategory? @relation(fields: [subcategoryId], references: [id], onDelete: SetNull)

  /// Название конкретного расхода («Подписка OpenAI»). Пусто — показываем имя категории.
  title String?

  /// Смысл суммы задаёт `kind`: ONE_OFF и DAILY — за день, MONTHLY — за месяц,
  /// RANGE — за весь срок. По дням она в любом случае размазывается ровно.
  amountCents Int
  currency    String @default("USD")

  /// ONE_OFF | DAILY | MONTHLY | RANGE
  kind String

  /// UTC-полночь локального дня — конвенция Order.deliveryDate и DailyFlowerExpense.
  startDay DateTime
  /// NULL у ONE_OFF и у бессрочных DAILY/MONTHLY.
  endDay   DateTime?

  createdBy String
  createdAt DateTime @default(now())
  updatedBy String?
  updatedAt DateTime @updatedAt

  @@index([startDay])
  @@index([endDay])
  @@index([categoryId])
  @@index([subcategoryId])
}

/// Раскладка печатного листа записок. Выбирается настройкой флориста `financeVisibility`:
/// FULL → TALL, MAKER_ONLY → WIDE (см. print/order-cards/page.tsx).
enum PrintLayoutKind {
  /// Альбомный лист, 4 карточки сеткой 2×2.
  WIDE
  /// Портретный лист, 2 карточки одна над другой.
  TALL
}

/// Настройки печати записок для ОДНОЙ раскладки. Ровно две строки — WIDE и TALL.
///
/// Здесь только тюнинг: размер листа, ориентация и сетка сюда не входят, это сам формат и
/// живёт он в коде (`SHEET_FORMAT`). Строки может не быть — тогда работают значения по
/// умолчанию из `PRINT_DEFAULTS`, поэтому печать не зависит от того, заходил ли владелец
/// в настройки.
///
/// Дробных чисел нет намеренно: поле листа в тысячных дюйма (500 = 0.5in), интерлиньяж в
/// процентах (140 = 1.4). Целые не накапливают ошибку округления и одинаково выглядят в
/// форме, в БД и в CSS.
model PrintLayoutSettings {
  layout PrintLayoutKind @id

  /// Непечатаемая кромка принтера, тысячные дюйма. Уменьшает карточку со всех сторон.
  safeMarginMils Int
  /// Поле для текста записки, px при 96dpi. Отступы карточки — то же число с другой
  /// стороны: (карточка − поле) / 2. Крутится одно, показываются оба.
  textWidthPx    Int
  textHeightPx   Int

  /// Кегль записки: потолок, пол, с какой строки мельчает и на сколько.
  basePt        Int
  minPt         Int
  baseMaxLines  Int
  crowdedStepPt Int
  /// Интерлиньяж записки, проценты (140 = 1.4).
  lineHeightPct Int

  /// Блок получателя: кегль и подъём над серединой карточки, px.
  recipientPt     Int
  recipientLiftPx Int

  updatedBy String?
  updatedAt DateTime @updatedAt
}

// ─────────────────────────  ПЕРЕПИСКА ПО EMAIL (Email Factory)  ─────────────────────────

/**
 * Письмо, относящееся к заказу: входящее от клиента или наш ручной ответ. Провайдер —
 * Email Factory (`mail.binetex.com`), ТОЛЬКО ручная переписка. Автоматические письма по событиям
 * заказа живут в Brevo и сюда НЕ попадают: у них своя история в AutomationJob, и смешивать нельзя,
 * иначе появится соблазн отвечать на автоматическое письмо из карточки.
 * Почему отдельная модель, а не тип EMAIL в OrderCommunication: та таблица целиком про телефонию —
 * `externalPhone` обязателен, есть длительность звонка, запись, транскрипт, привязка к номеру
 * магазина в QUO. Письмо не имеет ни одного из этих полей и имеет свои (тема, тред). Втискивание
 * дало бы наполовину пустую строку и вечное «если тип SMS, то…» в каждом запросе.
 * `orderId` НЕОБЯЗАТЕЛЕН намеренно. Опрос сохраняет все входящие письма, а к заказу привязываются
 * не все: клиент мог написать с другого адреса или не по заказу вовсе. Непривязанные НЕ
 * показываются нигде — они нужны только как курсор опроса: без них `since` застревал бы на
 * последнем привязанном письме и одни и те же письма выгружались бы снова и снова.
 */
model OrderEmailMessage {
  id      String  @id @default(cuid())
  orderId String?
  order   Order?  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  provider          String  @default("EMAIL_FACTORY")
  /**
   * id письма у провайдера. Ключ идемпотентности опроса: одно письмо — одна строка.
   */
  providerMessageId String? @unique
  /**
   * Тред у провайдера — по нему уходит ответ (`POST /threads/{id}/reply`).
   */
  threadId          String?

  direction CommunicationDirection
  status    EmailMessageStatus     @default(RECEIVED)

  fromEmail String
  toEmail   String
  subject   String?
  /**
   * ТОЛЬКО plain text. HTML не храним и не показываем: в карточке нужен смысл, а не вёрстка.
   */
  text      String

  occurredAt DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  /**
   * Идемпотентность исходящих — как `sendKey` у OrderCommunication. Строка создаётся ДО вызова
   * провайдера: иначе успешная отправка, оборвавшаяся до записи, оставила бы клиента с письмом,
   * которого нет в карточке, а повтор отправил бы второе.
   */
  sendKey      String? @unique
  sentByUserId String?
  errorSafe    String?

  @@index([orderId, occurredAt])
  @@index([direction, occurredAt])
}

enum EmailMessageStatus {
  RECEIVED // входящее
  PENDING // исходящее: строка создана, провайдер ещё не ответил
  SENT
  FAILED
}
