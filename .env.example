# Опись переменных окружения Floremart. Скопируйте в .env.local и заполните нужное.
# Пустая переменная почти везде означает «функция выключена», а не поломку: каждая
# интеграция умеет честно молчать, пока её не настроили.

# ── База и вход ──────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:pass@localhost:5432/floremart
DIRECT_URL=                        # прямое подключение для prisma migrate (в обход пулера);
                                   # пусто = использовать DATABASE_URL
AUTH_SECRET=                       # подпись сессий; обязательна в production
OWNER_PASSWORD=                    # только для scripts/create-owner.ts

# ── Шифрование credentials интеграций (IntegrationSecret) ────────────────────
CREDENTIALS_ENCRYPTION_KEY=        # 32 байта base64; без него не сохранить ни один токен
# Ротация: КЛЮЧИ — это JSON-объект, не список. Другой формат роняет расшифровку всех
# интеграций разом при первом же обращении (см. lib/crypto/secretBox.ts).
CREDENTIALS_ENCRYPTION_KEYS=       # {"1":"<base64>","2":"<base64>"}
CREDENTIALS_ENCRYPTION_ACTIVE_KEY= # id ключа из набора, которым шифровать новое (напр. "2")

# ── Финансовые гейты (см. modules/finance/config.ts) ─────────────────────────
# Без любого из них соответствующий заработок не считается ВОВСЕ — это защита,
# а не дефолт. На проде: true / 2026-08-01 / 2026-08-01.
FINANCE_ACCRUAL_ENABLED=true
FINANCE_ACCRUAL_START_DATE=2026-08-01
FINANCE_PRIMARY_SHARE_START_DATE=2026-08-01

# ── Рубильники интеграций (lib/featureFlags.ts): "true" включает ───────────
SHOPIFY_ENABLED=
WOOCOMMERCE_ENABLED=
QUO_ENABLED=
BURQ_ENABLED=
EMAIL_ENABLED=

# ── Доставка Burq ────────────────────────────────────────────────────────────
BURQ_RUNTIME_ENABLED=true          # общий рубильник: false глушит и черновики, и опросы
BURQ_API_KEY=
BURQ_API_BASE=                     # пусто = боевой API Burq
BURQ_WEBHOOK_SECRET=
BURQ_RECONCILE_MS=                 # период реконсиляции расписаний (умолч. 1 час)
WOO_ORDER_RECOVERY_MS=            # догоняющий синк заказов Woo, мс (по умолчанию 600000 = 10 мин)
BURQ_STATUS_SYNC_MS=               # период опроса молчащих доставок (умолч. 15 минут)
BURQ_POD_REFETCH_DELAY_MS=         # задержка дотяжки фото после delivered

# ── SMS (QUO) ────────────────────────────────────────────────────────────────
# ── ИИ-ассистент клиентской переписки (DeepSeek) ──
# Без ключа ассистент молча не работает — это не ошибка, а «не настроено».
# Секретный заголовок Telegram: задаётся при регистрации вебхука, проверяется на приёме.
TELEGRAM_WEBHOOK_SECRET=

# Распознавание голосовых владельца в Telegram. OpenAI-совместимый формат — подходит и OpenAI
# Whisper, и Groq. Не задано — голосовые не принимаются, бот просит написать текстом.
SPEECH_API_KEY=
SPEECH_BASE_URL=                   # по умолчанию https://api.openai.com/v1 (Groq: https://api.groq.com/openai/v1)
SPEECH_MODEL=                      # по умолчанию whisper-1 (Groq: whisper-large-v3-turbo)

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=                 # по умолчанию https://api.deepseek.com
DEEPSEEK_MODEL=                    # по умолчанию deepseek-chat

QUO_API_KEY=
QUO_API_BASE_URL=
QUO_WEBHOOK_SIGNING_KEYS=          # ключи проверки подписи вебхуков, через запятую

# ── Email (Brevo) ────────────────────────────────────────────────────────────
BREVO_API_KEY=                     # запасной путь; основной ключ лежит шифрованным в БД

# ── Airwallex ────────────────────────────────────────────────────────────────
AIRWALLEX_MONITORING_ENABLED=      # true включает сверку платежей воркером
AIRWALLEX_DISPATCH_MS=             # период диспетчера проверок (умолч. 5 минут)

# ── Telegram ─────────────────────────────────────────────────────────────────
TELEGRAM_ENABLED=                  # запасной рубильник; основной — в настройках в БД

# ── Email Factory (ручная переписка) ─────────────────────────────────────────
EMAIL_FACTORY_INGEST_MS=           # период опроса входящих (умолч. 5 минут)

# ── Отзывы ───────────────────────────────────────────────────────────────────
REVIEWS_DEADLINE_MS=               # период проверки «обещал и забыл» (умолч. 1 час)

# ── Shopify / WooCommerce ────────────────────────────────────────────────────
SHOPIFY_CLIENT_ID=                 # OAuth custom app; обязана идти парой с SECRET
SHOPIFY_CLIENT_SECRET=             # подпись вебхуков custom app
WOO_STORE_URL=                     # только для разовых скриптов; магазины живут в БД
WOO_CONSUMER_KEY=
WOO_CONSUMER_SECRET=

# ── Воркер и outbox ──────────────────────────────────────────────────────────
OUTBOX_POLL_MS=                    # период опроса очереди
OUTBOX_BATCH_SIZE=
OUTBOX_STUCK_MS=                   # когда PROCESSING считается зависшим
WORKER_ID=                         # имя воркера в логах; умолч. генерируется
WORKER_HEARTBEAT_FILE=
WORKER_HEARTBEAT_MAX_AGE_MS=

# ── Прочее ───────────────────────────────────────────────────────────────────
APP_URL=https://floremart.com      # абсолютные ссылки в сообщениях (телеграм, SMS)
